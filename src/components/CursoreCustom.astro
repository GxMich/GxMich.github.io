---
/**
 * Cerchio che insegue il puntatore con un ritardo elastico, si allarga e si
 * riempie di bianco sopra le cose cliccabili.
 *
 * Era un componente React con motion. Funzionava, ma era anche l'unica ragione
 * per cui pagine come /servizi e /contatti — che non hanno nessun'altra parte
 * interattiva — si tiravano dietro React, react-dom e motion: 57 KB compressi
 * per disegnare un cerchio e muoverlo. Qui la stessa cosa sta in una manciata
 * di righe e un requestAnimationFrame.
 *
 * Due regole non trattabili, identiche a prima: compare solo dove esiste un
 * mouse vero e chi ha chiesto meno movimento non lo vede; e non tocca mai il
 * contorno di messa a fuoco, che resta quello nativo — chi naviga da tastiera
 * non deve dipendere da un cerchietto che segue un mouse fermo.
 *
 * transition:persist lo tiene vivo attraverso i cambi pagina: senza, a ogni
 * clic il cerchio sparirebbe e ricomparirebbe al centro dello schermo.
 */
---

<div id="cursore" aria-hidden="true" transition:persist></div>

<script>
  interface Stato {
    avviato: boolean;
  }
  // Lo stato vive sulla finestra perché il modulo gira una volta sola ma
  // astro:page-load scatta a ogni navigazione: senza guardia partirebbero
  // più cicli di animazione sullo stesso elemento.
  const w = window as unknown as Window & { __cursore?: Stato };

  function avvia() {
    if (w.__cursore?.avviato) return;

    const nodo = document.getElementById('cursore');
    if (!nodo) return;

    const mouseVero = window.matchMedia('(pointer: fine)');
    const movimentoOk = window.matchMedia('(prefers-reduced-motion: no-preference)');
    if (!mouseVero.matches || !movimentoOk.matches) return;

    w.__cursore = { avviato: true };
    document.documentElement.classList.add('cursore-custom');
    nodo.style.opacity = '1';

    const CLICCABILI = 'a, button, [role="button"], input, select, textarea, label, summary';

    /**
     * Una molla vera, non un inseguimento lineare.
     *
     * Prima recuperavo un settimo della distanza a ogni fotogramma: il
     * cerchio arrivava sempre in ritardo e si fermava di colpo, senza mai
     * quel filo di superamento che rende il movimento vivo. Qui c'è
     * un'accelerazione proporzionale alla distanza (rigidità) e un attrito
     * che la frena (smorzamento): il cerchio parte deciso, supera di un
     * soffio il bersaglio e si assesta.
     *
     * A 0,82 lo smorzamento è appena sotto il punto critico — abbastanza da
     * sentire l'elasticità, non tanto da far rimbalzare.
     */
    const RIGIDITA = 0.16;
    const SMORZAMENTO = 0.82;

    let bersaglioX = -100;
    let bersaglioY = -100;
    let x = -100;
    let y = -100;
    let vx = 0;
    let vy = 0;
    let dimensione = 14;
    let bersaglioDim = 14;

    const muovi = (e: PointerEvent) => {
      bersaglioX = e.clientX;
      bersaglioY = e.clientY;
      const sopra = (e.target as Element | null)?.closest?.(CLICCABILI);
      bersaglioDim = sopra ? 46 : 14;
    };
    const premi = () => (bersaglioDim *= 0.82);
    const rilascia = () => (bersaglioDim = bersaglioDim > 30 ? 46 : 14);
    const esci = () => (bersaglioX = -100);

    window.addEventListener('pointermove', muovi, { passive: true });
    window.addEventListener('pointerdown', premi);
    window.addEventListener('pointerup', rilascia);
    document.addEventListener('pointerleave', esci);

    const passo = () => {
      vx = (vx + (bersaglioX - x) * RIGIDITA) * SMORZAMENTO;
      vy = (vy + (bersaglioY - y) * RIGIDITA) * SMORZAMENTO;
      x += vx;
      y += vy;
      dimensione += (bersaglioDim - dimensione) / 4.5;
      // translate3d e non top/left: così il lavoro lo fa il compositore e il
      // cerchio non costringe il browser a ricalcolare il layout 60 volte al
      // secondo mentre l'utente muove il mouse.
      nodo.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
      nodo.style.width = `${dimensione}px`;
      nodo.style.height = `${dimensione}px`;
      requestAnimationFrame(passo);
    };
    requestAnimationFrame(passo);
  }

  document.addEventListener('astro:page-load', avvia);
</script>

<style is:global>
  #cursore {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: #fafafa;
    pointer-events: none;
    opacity: 0;
    /* Parte già fuori schermo. Senza, fra il momento in cui lo script alza
       l'opacità e il primo fotogramma utile c'è un istante in cui il cerchio
       si vede fermo nell'angolo in alto a sinistra. */
    transform: translate3d(-100px, -100px, 0) translate(-50%, -50%);
    /* differenza: sopra il nero diventa bianco, sopra il bianco si inverte.
       È il motivo per cui il cerchio si legge ovunque senza usare un colore. */
    mix-blend-mode: difference;
  }
</style>
