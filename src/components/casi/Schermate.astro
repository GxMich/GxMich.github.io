---
/**
 * La galleria delle schermate.
 *
 * Per i siti scorre in orizzontale: sono pagine, e sfogliarle di lato è il
 * gesto giusto. Per i sistemi resta impilata: quelle non sono pagine, sono
 * diagrammi e ognuno va guardato fermo.
 *
 * Come in home, lo scorrimento nativo è il punto di partenza e non il ripiego:
 * se il JavaScript non arriva, le schermate restano tutte raggiungibili.
 */
import { Image } from 'astro:assets';
import { originale } from '../../lib/immagini.ts';

interface Props {
  schermate: { src: string; alt: string }[];
  laterale?: boolean;
}

const { schermate, laterale = false } = Astro.props;
const scorre = laterale && schermate.length > 1;
---

<div
  class:list={['galleria', { laterale: scorre }]}
  tabindex={scorre ? 0 : undefined}
  role={scorre ? 'group' : undefined}
  aria-label={scorre ? 'Schermate, scorrimento orizzontale' : undefined}
>
  {
    schermate.map((s, i) => {
      const img = originale(s.src);
      if (!img) return null;
      const eVettore = s.src.toLowerCase().endsWith('.svg');
      /* Una schermata di telefono va trattata da telefono: se prende la
         larghezza di una desktop diventa alta il triplo. La forma la so già
         qui, dal file, e non serve chiederla al browser. */
      const eRitratto = img.height > img.width;
      return (
        <figure class:list={['scatto', { ritratto: eRitratto }]}>
          {eVettore ? (
            <img src={img.src} alt={s.alt} width={img.width} height={img.height} loading="lazy" />
          ) : (
            <Image
              src={img}
              alt={s.alt}
              widths={[540, 900, 1400]}
              sizes={scorre ? '(max-width: 767px) 88vw, 62vw' : '(max-width: 900px) 100vw, 62vw'}
              formats={['avif', 'webp']}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          )}
          <figcaption class="etichetta">{s.alt}</figcaption>
        </figure>
      );
    })
  }
</div>

<style>
  .galleria {
    display: grid;
    gap: var(--sp-7);
  }

  .laterale {
    display: flex;
    gap: clamp(16px, 2.4vw, 32px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--sp-4);
  }

  /* Nella fila le schermate si allineano per altezza, non per larghezza.
     Alla stessa larghezza, una schermata di telefono diventa una colonna alta
     il triplo di una desktop e da sola si mangia la sezione: allineandole per
     altezza ognuna tiene la sua forma e la fila resta una fila. La larghezza
     minima è per la didascalia, che sotto un ritratto stretto diventerebbe
     una colonna di due parole per riga. */
  .laterale .scatto {
    flex: 0 0 auto;
    width: auto;
    min-width: min(60vw, 280px);
    scroll-snap-align: start;
  }

  .laterale .scatto img {
    height: min(56vh, 500px);
    width: auto;
    max-width: min(78vw, 780px);
  }

  .scatto {
    margin: 0;
    display: grid;
    gap: var(--sp-3);
  }

  .scatto img {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius-2);
    background: var(--paper-sunk);
  }

  .scatto figcaption {
    max-width: 62ch;
    text-transform: none;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  @media (max-width: 767px) {
    .laterale {
      flex-direction: column;
      overflow: visible;
    }

    .laterale .scatto {
      width: 100%;
      min-width: 0;
    }

    /* Impilate torna a comandare la larghezza: `width` e proporzioni note in
       anticipo tengono lo spazio prima che l'immagine arrivi, e la pagina non
       salta sotto le dita mentre si scorre. */
    .laterale .scatto img {
      height: auto;
      width: 100%;
      max-width: 100%;
    }
  }

  /* Il ritratto resta stretto ovunque: è l'unica misura che gli impedisce di
     occupare da solo uno schermo intero.
     `.galleria` davanti non è ornamentale: Astro appende il proprio attributo
     di scope a ogni pezzo del selettore, quindi `.laterale .scatto img` pesa
     più di `.scatto.ritratto img` e vincerebbe lui. */
  .galleria .scatto.ritratto img {
    max-width: min(58vw, 260px);
    margin-inline: auto;
  }
</style>
