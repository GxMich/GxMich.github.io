---
/**
 * Interruttore del tema.
 *
 * Tre stati possibili nel salvataggio, non due: chiaro, scuro, o niente. Niente
 * significa «segui il sistema», ed è il valore di partenza — è la scelta che
 * l'utente ha già fatto altrove e che nessun sito dovrebbe ignorare. Il bottone
 * scrive una preferenza esplicita solo quando qualcuno lo tocca.
 */
import Icona from './Icona.astro';
---

<button class="tema" type="button" data-tema-bottone aria-pressed="false">
  <span class="solo-lettori" data-tema-etichetta>Passa al tema scuro</span>
  <span class="quadro" aria-hidden="true">
    <span class="faccia sole"><Icona nome="sole" dimensione={17} /></span>
    <span class="faccia luna"><Icona nome="luna" dimensione={17} /></span>
  </span>
</button>

<style>
  .tema {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--ink-2);
    border: 1px solid transparent;
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  .tema:hover {
    color: var(--ink);
    border-color: var(--rule);
  }

  /* Le due facce stanno nella stessa cella e ruotano una dentro l'altra: è la
     stessa lampadina che si gira, non due icone che si scambiano. */
  .quadro {
    position: relative;
    display: grid;
    width: 17px;
    height: 17px;
  }

  .faccia {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .faccia.luna {
    opacity: 0;
    transform: rotate(-70deg) scale(0.6);
  }

  :global(html[data-tema='scuro']) .faccia.sole {
    opacity: 0;
    transform: rotate(70deg) scale(0.6);
  }

  :global(html[data-tema='scuro']) .faccia.luna {
    opacity: 1;
    transform: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-tema='chiaro'])) .faccia.sole {
      opacity: 0;
      transform: rotate(70deg) scale(0.6);
    }

    :global(html:not([data-tema='chiaro'])) .faccia.luna {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  function montaTema() {
    const bottone = document.querySelector<HTMLButtonElement>('[data-tema-bottone]');
    if (!bottone || bottone.dataset.montato !== undefined) return;
    bottone.dataset.montato = 'si';

    const etichetta = bottone.querySelector<HTMLElement>('[data-tema-etichetta]');
    const sistemaScuro = window.matchMedia('(prefers-color-scheme: dark)');

    const scuroAdesso = () => {
      const scelto = document.documentElement.dataset.tema;
      return scelto ? scelto === 'scuro' : sistemaScuro.matches;
    };

    function rifletti() {
      const scuro = scuroAdesso();
      bottone.setAttribute('aria-pressed', String(scuro));
      if (etichetta) {
        etichetta.textContent = scuro ? 'Passa al tema chiaro' : 'Passa al tema scuro';
      }
    }

    bottone.addEventListener('click', () => {
      const prossimo = scuroAdesso() ? 'chiaro' : 'scuro';
      document.documentElement.dataset.tema = prossimo;
      try {
        localStorage.setItem('tema', prossimo);
      } catch {
        /* navigazione privata: il tema vale per questa visita e basta */
      }
      rifletti();
    });

    /* Se non c'è una scelta esplicita, il sito segue il sistema anche quando
       cambia mentre la pagina è aperta. */
    sistemaScuro.addEventListener('change', () => {
      if (!document.documentElement.dataset.tema) rifletti();
    });

    rifletti();
  }

  montaTema();
  document.addEventListener('astro:page-load', montaTema);
</script>
