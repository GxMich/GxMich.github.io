---
import { SITE } from '../config.js';

/**
 * Due campi e via. Sta dentro la chiamata all'azione in fondo a ogni pagina,
 * e serve a togliere il passaggio che costava di più: prima, per scrivere,
 * bisognava cliccare, aspettare una pagina nuova e ricominciare a leggere.
 * Chi ha già deciso di scrivere non deve attraversare il sito per farlo.
 *
 * Manda allo stesso indirizzo del modulo lungo, con un campo in più che dice
 * da quale pagina è partito: sapere se scrivono dopo aver letto i prezzi o
 * dopo un case study cambia come rispondere.
 */
const origine = Astro.url.pathname;
---

<form class="rapido" method="POST" action={SITE.formEndpoint} data-rapido>
  <input type="hidden" name="access_key" value={SITE.formAccessKey} />
  <input type="hidden" name="subject" value="Messaggio rapido dal sito" />
  <input type="hidden" name="from_name" value={`Sito ${SITE.name}`} />
  <input type="hidden" name="origine" value={origine} />
  <input
    type="checkbox"
    name="botcheck"
    class="visually-hidden"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="riga">
    <div class="campo">
      <label for="rapido-contatto">Email o telefono</label>
      <input
        type="text"
        id="rapido-contatto"
        name="contatto"
        required
        autocomplete="email"
        placeholder="dove ti rispondo"
      />
    </div>

    <div class="campo campo-largo">
      <label for="rapido-messaggio">Cosa ti serve</label>
      <input
        type="text"
        id="rapido-messaggio"
        name="messaggio"
        required
        placeholder="due parole, anche disordinate"
      />
    </div>
  </div>

  <label class="consenso">
    <input type="checkbox" name="privacy" required />
    <span>
      Ho letto l'<a class="link-inline" href="/privacy">informativa</a> e acconsento
      a essere ricontattato.
    </span>
  </label>

  <div class="azioni">
    <button class="btn btn-solid" type="submit" data-invia-rapido>
      Mandalo
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path
          d="M3 7h8M7.5 3.5 11 7l-3.5 3.5"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
    <span class="rassicura">
      Rispondo io entro un giorno lavorativo — anche solo per dirti che non sono la
      persona giusta.
    </span>
  </div>

  <p class="avviso" data-esito-rapido role="status" aria-live="polite"></p>
</form>

<div class="fatto" data-fatto-rapido hidden>
  <span class="segno" aria-hidden="true"></span>
  <p class="fatto-titolo" tabindex="-1">Arrivato.</p>
  <p>
    Ti scrivo entro un giorno lavorativo da <strong>{SITE.email}</strong>. Se non
    vedi niente, guarda anche nello spam.
  </p>
</div>

<script>
  /**
   * Questo modulo compare in fondo a ogni pagina, quindi è quello che soffre
   * di più la navigazione senza ricaricamento: senza riagganciarlo, funziona
   * sulla prima pagina aperta e su nessuna delle successive.
   */
  function collegaRapido() {
    const form = document.querySelector<HTMLFormElement>('[data-rapido]');
    if (!form || form.dataset.collegato) return;
    form.dataset.collegato = '1';

    const fatto = document.querySelector<HTMLElement>('[data-fatto-rapido]');
    const esito = document.querySelector<HTMLElement>('[data-esito-rapido]');
    const invia = document.querySelector<HTMLButtonElement>('[data-invia-rapido]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const originale = invia?.innerHTML ?? '';
      if (invia) {
        invia.disabled = true;
        invia.textContent = 'Invio…';
      }
      if (esito) esito.textContent = '';

      try {
        const dati = Object.fromEntries(new FormData(form).entries());
        const risposta = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(dati),
        });
        if (!risposta.ok) throw new Error(String(risposta.status));

        form.hidden = true;
        if (fatto) {
          fatto.hidden = false;
          fatto.querySelector<HTMLElement>('.fatto-titolo')?.focus();
        }
      } catch {
        // Il messaggio di errore non lascia mai la persona senza una strada:
        // se il modulo non parte, i due canali diretti sono lì sopra.
        if (esito) {
          esito.textContent =
            'Non è partito. Riprova, oppure scrivimi direttamente per email o su WhatsApp: arrivo lo stesso.';
        }
        if (invia) {
          invia.disabled = false;
          invia.innerHTML = originale;
        }
      }
    });
  }

  document.addEventListener('astro:page-load', collegaRapido);
</script>

<style>
  .rapido {
    display: grid;
    gap: 16px;
    width: 100%;
  }
  .riga {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 12px;
  }
  .campo {
    display: grid;
    gap: 7px;
    min-width: 0;
  }
  .campo label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .campo input {
    width: 100%;
    font: inherit;
    font-size: 16px; /* sotto i 16px iOS ingrandisce da solo alla messa a fuoco */
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 14px;
    transition: border-color 0.2s ease;
  }
  .campo input:hover {
    border-color: var(--text-muted);
  }
  .campo input:focus-visible {
    border-color: var(--text);
  }
  .campo ::placeholder {
    color: var(--text-muted);
    opacity: 0.7;
  }

  .consenso {
    display: flex;
    gap: 10px;
    align-items: start;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 52ch;
  }
  .consenso input {
    margin-top: 2px;
    width: 18px;
    height: 18px;
    flex: none;
    accent-color: var(--text);
  }

  .azioni {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
  }
  .rassicura {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 34ch;
  }

  .avviso:empty {
    display: none;
  }
  .avviso {
    font-size: 14.5px;
    color: var(--text);
    border-left: 2px solid var(--text-muted);
    padding-left: 14px;
    max-width: 52ch;
  }

  /* ----------------------------- conferma ----------------------------- */
  .fatto {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .fatto .segno {
    display: block;
    width: 56px;
    height: 1px;
    background: var(--text);
    box-shadow: 0 0 14px rgba(255, 255, 255, 0.5);
  }
  .fatto-titolo {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 26px;
    letter-spacing: -0.02em;
  }
  .fatto-titolo:focus-visible {
    outline-offset: 6px;
  }
  .fatto p:not(.fatto-titolo) {
    color: var(--text-muted);
    font-size: 15px;
    max-width: 46ch;
  }
  .fatto strong {
    color: var(--text);
    font-weight: 500;
  }

  @media (max-width: 620px) {
    .riga {
      grid-template-columns: 1fr;
    }
  }
</style>
