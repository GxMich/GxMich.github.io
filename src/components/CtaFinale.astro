---
import FormRapido from './FormRapido.astro';
import { SITE } from '../config.js';

interface Props {
  titolo?: string;
  testo?: string;
  etichetta?: string;
}

const {
  etichetta = 'Iniziamo',
  titolo = 'Raccontami cosa ti serve.',
  testo = "Scrivimi due righe su cosa fai e cosa non funziona oggi. Ti rispondo io, di persona, entro un giorno lavorativo — anche solo per dirti che non sono la persona giusta.",
} = Astro.props;
---

<section class="cta scura" data-reveal-group>
  <div class="wrap inner">
    <div data-reveal>
      <p class="label">{etichetta}</p>
      <h2 class="display-sm">{titolo}</h2>
    </div>

    <div class="destra" data-reveal>
      <p class="lede">{testo}</p>
      <FormRapido />
      <p class="canali">
        Preferisci un altro canale?
        <a class="link-inline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <span aria-hidden="true"> · </span>
        <a class="link-inline" href={`https://wa.me/${SITE.whatsapp}`} rel="noopener">WhatsApp</a>
        <span aria-hidden="true"> · </span>
        <a class="link-inline" href="/contatti">modulo completo</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding-block: var(--section);
    border-top: 1px solid var(--border);
    overflow: hidden;
  }
  /* un solo bagliore, nessun altro effetto: qui la scena la fa il bordo
     animato del bottone e basta */
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(50% 60% at 50% 100%, var(--glow), transparent 70%);
  }
  /* Il modulo sta a destra e ha bisogno di larghezza: le due colonne si
     invertono di peso rispetto a prima, quando a destra c'era un bottone. */
  .inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(30px, 4vw, 72px);
    align-items: start;
  }
  .label {
    margin-bottom: 28px;
  }
  .destra {
    display: grid;
    gap: 22px;
    justify-items: start;
    width: 100%;
    min-width: 0;
  }
  .canali {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  /* qui i due link sono il contenuto della riga, non parole dentro una frase:
     l'eccezione delle WCAG per i link in linea non si applica */
  .canali a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
