---
import { SITE } from '../../config.js';
---

<section class="invito" aria-labelledby="invito-titolo">
  <div class="contenitore dentro">
    <div class="testo">
      <p class="etichetta">Se ti torna</p>
      <h2 id="invito-titolo" class="h2 sfoca-entra" data-anima>Raccontami cosa ti serve.</h2>
      <p class="testo-sm sfoca-entra" data-anima>
        Scegli l'argomento e aggiungi, se vuoi, qualche dettaglio. Preparo un messaggio da aprire su WhatsApp: lo leggi e lo invii tu.
      </p>
      <p class="testo-sm rassicura">
        Se il tuo progetto non è nelle mie corde te lo dico subito, e quando posso ti indico chi contattare.
      </p>
    </div>

    <form class="modulo" data-whatsapp={SITE.whatsapp}>
      <p class="campo">
        <label for="richiesta-servizio">Di cosa hai bisogno?</label>
        <select id="richiesta-servizio" name="servizio" required>
          <option value="" selected disabled>Scegli un'opzione</option>
          <option value="Un sito web per la mia attività">Un sito web per la mia attività</option>
          <option value="Rifare o migliorare il mio sito">Rifare o migliorare il mio sito</option>
          <option value="Un'automazione o uno strumento su misura">Un'automazione o uno strumento su misura</option>
          <option value="Vorrei un consiglio: non so ancora cosa mi serve">Vorrei un consiglio: non so ancora cosa mi serve</option>
          <option value="Altro">Altro</option>
        </select>
      </p>

      <p class="campo">
        <label for="richiesta-situazione">A che punto sei?</label>
        <select id="richiesta-situazione" name="situazione">
          <option value="Non ho ancora un sito">Non ho ancora un sito</option>
          <option value="Ho già un sito e vorrei migliorarlo">Ho già un sito e vorrei migliorarlo</option>
          <option value="Ho un'idea, ma devo ancora definirla" selected>Ho un'idea, ma devo ancora definirla</option>
        </select>
      </p>

      <p class="campo">
        <label for="richiesta-dettagli">Qualche dettaglio (facoltativo)</label>
        <textarea id="richiesta-dettagli" name="dettagli" rows="4" maxlength="1200" placeholder="Che attività hai? Cosa vorresti ottenere?"></textarea>
      </p>

      <button class="manda" type="submit">Prepara il messaggio su WhatsApp</button>
      <p class="informativa testo-sm">
        Le scelte non vengono inviate né salvate dal sito. WhatsApp si apre con il testo pronto: decidi tu se inviarlo.
        <a href="/privacy">Informativa privacy</a>.
      </p>
      <p class="esito testo-sm" data-esito role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .invito { padding-block: var(--section); border-top: 1px solid var(--ink); }
  .dentro { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .testo { display: grid; gap: var(--sp-4); align-content: start; }
  .testo h2 { max-width: 20ch; }
  .testo p { max-width: 46ch; }
  .modulo { display: grid; gap: var(--sp-5); }
  .campo { display: grid; gap: var(--sp-2); margin: 0; }
  label { font-family: var(--font-mono); font-size: var(--t-label); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); }
  select, textarea { font: inherit; font-size: var(--t-body); color: var(--ink); background: var(--paper-sunk); border: 1px solid var(--rule); border-radius: var(--radius-1); padding: 12px 14px; width: 100%; }
  select option { color: var(--ink); background: var(--paper-sunk); }
  select option:hover, select option:checked { color: var(--signal-on); background: var(--signal); }
  select:focus-visible, textarea:focus-visible, .manda:focus-visible { outline: 2px solid var(--signal-ink); outline-offset: 3px; }
  textarea { resize: vertical; min-height: 110px; line-height: 1.55; }
  .manda { font-family: var(--font-ui); font-size: var(--t-body-sm); font-weight: 500; background: var(--signal); color: var(--signal-on); border-radius: var(--radius-1); padding: 13px 22px; justify-self: start; transition: background-color var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out); }
  .manda:hover { background: var(--signal-ink); color: var(--paper); }
  .informativa, .esito { max-width: 52ch; margin: calc(-1 * var(--sp-3)) 0 0; color: var(--ink-2); }
  .informativa a { color: var(--signal-ink); text-underline-offset: 3px; }
  @media (max-width: 860px) { .dentro { grid-template-columns: 1fr; gap: var(--sp-7); } }
</style>

<script>
  function montaRichiestaWhatsApp() {
    document.querySelectorAll<HTMLFormElement>('.modulo[data-whatsapp]').forEach((form) => {
      if (form.dataset.montato) return;
      form.dataset.montato = 'si';
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const dati = new FormData(form);
        const servizio = String(dati.get('servizio') || '');
        const situazione = String(dati.get('situazione') || '');
        const dettagli = String(dati.get('dettagli') || '').trim();
        const righe = ['Ciao Michele, ti contatto dal sito.', '', `Mi serve: ${servizio}`, `Situazione: ${situazione}`];
        if (dettagli) righe.push('', `Qualche dettaglio: ${dettagli}`);
        const link = `https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(righe.join('\n'))}`;
        window.open(link, '_blank', 'noopener,noreferrer');
        const esito = form.querySelector<HTMLElement>('[data-esito]');
        if (esito) esito.textContent = 'Messaggio pronto. Controllalo su WhatsApp e premi Invia quando vuoi.';
      });
    });
  }
  montaRichiestaWhatsApp();
  document.addEventListener('astro:page-load', montaRichiestaWhatsApp);
</script>
