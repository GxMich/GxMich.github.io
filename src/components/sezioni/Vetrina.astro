---
/**
 * Frame 02 — la vetrina dei lavori.
 *
 * Riscritta. La versione precedente agganciava la sezione e la faceva panare di
 * lato: partiva tardi, lasciava un blocco di nero sotto e su un pannello solo
 * non aveva senso. Un aggancio è un contratto con chi scorre — «fermati qui,
 * ne vale la pena» — e per due immagini quel contratto non si ripaga.
 *
 * Ora è quello che deve essere: una fila di lavori che si sfoglia di lato con
 * lo scorrimento nativo. Funziona col dito, col trackpad, con le frecce e con i
 * due bottoni, non ha niente da calcolare e quindi non può lasciare buchi.
 */
import { Image } from 'astro:assets';
import { originale } from '../../lib/immagini.ts';

export interface Lavoro {
  href: string;
  titolo: string;
  nota: string;
  immagine?: string;
  alt: string;
}

interface Props {
  lavori: Lavoro[];
  titolo: string;
  occhiello: string;
}

const { lavori, titolo, occhiello } = Astro.props;
const sfogliabile = lavori.length > 1;
---

<section class="vetrina su-palco" aria-labelledby="vetrina-titolo">
  <div class="contenitore intestazione">
    <div class="parole">
      <p class="etichetta">{occhiello}</p>
      <h2 id="vetrina-titolo" class="h2 sfoca-entra" data-anima>{titolo}</h2>
    </div>

    {
      sfogliabile && (
        <div class="comandi" data-comandi>
          <button type="button" data-vai="-1">
            <span class="solo-lettori">Lavoro precedente</span>
            <span aria-hidden="true">←</span>
          </button>
          <button type="button" data-vai="1">
            <span class="solo-lettori">Lavoro successivo</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      )
    }
  </div>

  <div
    class="pista"
    data-pista
    tabindex={sfogliabile ? 0 : undefined}
    role={sfogliabile ? 'group' : undefined}
    aria-label={sfogliabile ? 'Lavori — si sfoglia di lato' : undefined}
  >
    {
      lavori.map((l, i) => {
        const img = originale(l.immagine);
        return (
          <a class="lavoro" href={l.href} data-lavoro>
            {img && (
              <div class="cornice">
                <Image
                  src={img}
                  alt={l.alt}
                  widths={[420, 720, 1100]}
                  sizes="(max-width: 767px) 84vw, 46vw"
                  formats={['avif', 'webp']}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            )}
            <div class="sotto">
              <span class="nome h3">{l.titolo}</span>
              <span class="etichetta nota">{l.nota}</span>
              <span class="vai">
                Guarda com'è venuto <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        );
      })
    }
  </div>
</section>

<style>
  .vetrina {
    background: var(--stage);
    color: var(--light);
    padding-block: var(--section-sm);
    margin-block: var(--section);
  }

  .intestazione {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--sp-5);
    padding-bottom: var(--sp-7);
  }

  .parole {
    display: grid;
    gap: var(--sp-3);
  }

  .parole .etichetta {
    color: var(--light-2);
  }

  .parole h2 {
    max-width: 20ch;
  }

  .comandi {
    display: flex;
    gap: var(--sp-2);
  }

  .comandi button {
    width: 46px;
    height: 46px;
    border: 1px solid var(--edge);
    border-radius: var(--radius-1);
    color: var(--light-2);
    font-size: 17px;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .comandi button:hover:not(:disabled) {
    border-color: var(--light-2);
    color: var(--light);
  }

  .comandi button:disabled {
    opacity: 0.32;
    cursor: default;
  }

  /* Scorrimento nativo con aggancio: nessun calcolo, nessuno spazio morto, e
     il dito fa quello che ci si aspetta. I margini interni allineano il primo
     e l'ultimo lavoro al contenitore. */
  .pista {
    display: flex;
    gap: clamp(16px, 2.4vw, 32px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-inline: var(--gutter);
    padding-bottom: var(--sp-4);
    scrollbar-width: thin;
    scrollbar-color: var(--edge) transparent;
  }

  .lavoro {
    flex: 0 0 auto;
    width: min(46vw, 620px);
    scroll-snap-align: start;
    text-decoration: none;
    display: grid;
    gap: var(--sp-4);
    align-content: start;
  }

  .cornice {
    border: 1px solid var(--edge);
    border-radius: var(--radius-2);
    overflow: hidden;
    background: var(--stage-2);
  }

  .cornice img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .lavoro:hover .cornice img {
    transform: scale(1.02);
  }

  .sotto {
    display: grid;
    gap: var(--sp-2);
  }

  .nome {
    letter-spacing: -0.025em;
  }

  .nota {
    color: var(--light-2);
  }

  .vai {
    font-size: var(--t-body-sm);
    font-weight: 500;
    color: var(--signal);
    margin-top: var(--sp-1);
  }

  .vai span {
    display: inline-block;
    transition: transform var(--dur-1) var(--ease-out);
  }

  .lavoro:hover .vai span {
    transform: translateX(4px);
  }

  /* Con un lavoro solo non c'è niente da sfogliare: occupa la larghezza piena
     e la pista smette di comportarsi come una pista. */
  .pista:has(> :only-child) {
    overflow: visible;
  }

  .pista:has(> :only-child) .lavoro {
    width: 100%;
    max-width: calc(var(--page-max) - var(--gutter) * 2);
    margin-inline: auto;
  }

  @media (max-width: 767px) {
    .lavoro {
      width: 84vw;
    }

    .comandi {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lavoro:hover .cornice img {
      transform: none;
    }
  }
</style>

<script>
  function montaVetrina() {
    const pista = document.querySelector<HTMLElement>('[data-pista]');
    const comandi = document.querySelector<HTMLElement>('[data-comandi]');
    if (!pista || !comandi || pista.dataset.montato !== undefined) return;

    pista.dataset.montato = 'si';

    const lavori = Array.from(pista.querySelectorAll<HTMLElement>('[data-lavoro]'));
    const bottoni = Array.from(comandi.querySelectorAll<HTMLButtonElement>('[data-vai]'));

    const aggiornaBottoni = () => {
      const fine = pista.scrollWidth - pista.clientWidth;
      bottoni[0].disabled = pista.scrollLeft <= 2;
      bottoni[1].disabled = pista.scrollLeft >= fine - 2;
    };

    bottoni.forEach((b) =>
      b.addEventListener('click', () => {
        const verso = Number(b.dataset.vai);
        // Il passo è il lavoro più il divario: così si arriva sempre allineati
        // all'aggancio invece che a metà di una scheda.
        const passo = lavori[0].offsetWidth + parseFloat(getComputedStyle(pista).gap || '0');
        pista.scrollBy({ left: passo * verso, behavior: 'smooth' });
      })
    );

    pista.addEventListener('scroll', aggiornaBottoni, { passive: true });
    window.addEventListener('resize', aggiornaBottoni, { passive: true });
    aggiornaBottoni();
  }

  montaVetrina();
  document.addEventListener('astro:page-load', montaVetrina);
</script>
