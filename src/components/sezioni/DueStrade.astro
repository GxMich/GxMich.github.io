---
/**
 * Frame 03 — le due strade.
 *
 * Sfalsate e non affiancate simmetriche: la simmetria direbbe che le due
 * offerte pesano uguale, e il pubblico di questo sito arriva quasi sempre
 * dalla prima.
 *
 * La versione precedente erano due blocchi di testo con un filetto sopra, e si
 * vedeva: due link travestiti da sezione. Ora sono due schede vere, una chiara
 * e una scura, ognuna con il suo segno e il suo numero — la differenza fra le
 * due strade si vede prima di leggerle.
 */
import Icona from '../comuni/Icona.astro';
---

<section class="strade" aria-labelledby="strade-titolo">
  <div class="contenitore dentro">
    <h2 id="strade-titolo" class="solo-lettori">Cosa faccio</h2>

    <a class="strada prima sfoca-entra" href="/servizi" data-anima>
      <span class="riga-alta" aria-hidden="true"></span>
      {/*
        Il destinatario detto per nome, non lasciato indovinare.

        Le due schede si distinguono già a colpo d'occhio, ma la differenza che
        si vede è «una chiara e una scura»: non dice a chi parlano. Un
        ristoratore che legge «Per aziende e professionisti» sulla seconda
        capisce in mezzo secondo che non lo riguarda, e smette di leggerla.
      */}
      <span class="testa">
        <span class="marca">
          <span class="indice dato">01</span>
          <span class="pubblico etichetta">Per attività locali</span>
        </span>
        <span class="segno"><Icona nome="finestra" dimensione={22} /></span>
      </span>
      <span class="etichetta">Hai un'attività</span>
      <span class="h2 titolo">Falla riconoscere prima che entrino dalla porta</span>
      <span class="testo-sm corpo">
        Un sito costruito intorno alla tua attività, alla tua storia e alle persone che vuoi
        raggiungere.
      </span>
      <span class="vai">
        Cosa comprende
        <Icona nome="freccia" dimensione={16} />
      </span>
    </a>

    <a class="strada seconda su-palco sfoca-entra" href="/progetti" data-anima data-parallasse>
      <span class="riga-alta" aria-hidden="true"></span>
      <span class="testa">
        <span class="marca">
          <span class="indice dato">02</span>
          <span class="pubblico etichetta">Per aziende e professionisti</span>
        </span>
        <span class="segno"><Icona nome="flusso" dimensione={22} /></span>
      </span>
      <span class="etichetta">Hai un processo che si inceppa</span>
      <span class="h2 titolo">Fai smettere al lavoro ripetitivo di rubarti tempo</span>
      <span class="testo-sm corpo">
        Strumenti e automazioni costruiti sul tuo modo di lavorare, invece di costringerti ad
        adattarti a un software generico.
      </span>
      <span class="vai">
        Guarda gli strumenti
        <Icona nome="freccia" dimensione={16} />
      </span>
    </a>
  </div>
</section>

<style>
  .strade {
    padding-block: var(--section);
  }

  .dentro {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
  }

  .strada {
    position: relative;
    display: grid;
    gap: var(--sp-4);
    align-content: start;
    text-decoration: none;
    padding: clamp(28px, 3.4vw, 48px);
    border-radius: var(--radius-2);
    border: 1px solid var(--rule);
    background: var(--paper-sunk);
    color: var(--ink);
    overflow: hidden;
    transition:
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .seconda {
    background: var(--stage);
    border-color: var(--edge);
    /* Lo sfalsamento è la sezione: senza, sono due schede uguali. */
    margin-top: clamp(40px, 7vw, 96px);
  }

  .strada:hover {
    transform: translateY(-4px);
    border-color: var(--signal);
  }

  /* Un filo d'accento che si tira da sinistra a destra sul bordo alto:
     è il segno che dice «questa è la scheda che stai guardando». */
  .riga-alta {
    position: absolute;
    inset: 0 auto auto 0;
    height: 2px;
    width: 100%;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .strada:hover .riga-alta {
    transform: scaleX(1);
  }

  .testa {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--rule);
  }

  .marca {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    min-width: 0;
  }

  .indice {
    color: var(--ink-3);
    letter-spacing: 0.14em;
  }

  /* Un riquadro sottile e non un fondo pieno: deve etichettare la scheda,
     non competere con il titolo che sta sotto. */
  .pubblico {
    padding: 4px 9px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .segno {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--ink-2);
    transition:
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .strada:hover .segno {
    color: var(--signal);
    border-color: var(--signal);
    transform: rotate(-6deg);
  }

  /* Le righe dentro la finestra si allungano, i rami del flusso si disegnano:
     ogni segno racconta la sua strada invece di stare fermo. */
  .strada .segno :global(.riga) {
    transform: scaleX(0.45);
  }

  .strada:hover .segno :global(.riga) {
    transform: scaleX(1);
  }

  .strada .segno :global(.ramo) {
    stroke-dashoffset: 14;
  }

  .strada:hover .segno :global(.ramo) {
    stroke-dashoffset: 0;
  }

  .strada:hover .segno :global(.secondo) {
    transform: scale(1.25);
  }

  .titolo {
    max-width: 18ch;
    display: block;
  }

  .corpo {
    max-width: 40ch;
    display: block;
  }

  .vai {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--t-body-sm);
    font-weight: 500;
    color: var(--signal-ink);
    margin-top: var(--sp-2);
  }

  .vai :global(.asta) {
    transform: scaleX(0.4);
  }

  .strada:hover .vai :global(.asta) {
    transform: scaleX(1);
  }

  .strada:hover .vai :global(.punta) {
    transform: translateX(3px);
  }

  @media (max-width: 767px) {
    .dentro {
      grid-template-columns: 1fr;
    }

    .seconda {
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strada:hover,
    .strada:hover .segno {
      transform: none;
    }
  }
</style>

<script>
  import { caricaGsap, movimentoRiccoAmmesso } from '../../lib/movimento.ts';

  function montaParallasse() {
    const veloce = document.querySelector<HTMLElement>('[data-parallasse]');
    if (!veloce || veloce.dataset.montato !== undefined) return;
    if (!movimentoRiccoAmmesso()) return;

    veloce.dataset.montato = 'si';

    caricaGsap().then(({ gsap }) => {
      gsap.fromTo(
        veloce,
        { y: 44 },
        {
          y: -44,
          ease: 'none',
          scrollTrigger: {
            trigger: veloce.parentElement,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
            invalidateOnRefresh: true,
          },
        }
      );
    });
  }

  montaParallasse();
  document.addEventListener('astro:page-load', montaParallasse);
</script>
