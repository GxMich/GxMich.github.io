---
/**
 * Frame 04 — come si lavora, a carte impilate.
 *
 * L'impilamento non è un vezzo: i quattro passi sono una sequenza, e la carta
 * che resta sotto è la fase già superata. È l'unica sezione del sito dove
 * "deck of cards" dice qualcosa di vero sul contenuto.
 *
 * Quattro e non sette: sette sarebbero un'infografica, quattro sono un impegno.
 */
const passi = [
  {
    n: '01',
    titolo: 'Capire',
    testo:
      'Prima di disegnare una pagina capiamo cosa fai, chi vuoi raggiungere e perché qualcuno dovrebbe scegliere te. Senza questa parte tutto il resto è arredamento.',
    chi: 'Solo io',
  },
  {
    n: '02',
    titolo: 'Esplorare',
    testo:
      'Uso la macchina per esplorare più direzioni in fretta, senza che il progetto finisca per somigliare a tutti gli altri.',
    chi: 'Io + macchina',
  },
  {
    n: '03',
    titolo: 'Decidere',
    testo:
      'Scelgo cosa tenere, cosa togliere e cosa dire. La macchina propone, e spesso propone la cosa media. La decisione resta mia.',
    chi: 'Solo io',
  },
  {
    n: '04',
    titolo: 'Costruire',
    testo:
      'Codice, telefono, velocità, accessibilità, ricerca locale. Poi ti consegno qualcosa che puoi davvero usare da solo.',
    chi: 'Io + macchina',
  },
];
---

<section class="metodo" aria-labelledby="metodo-titolo">
  <div class="contenitore">
    <div class="intestazione">
      <h2 id="metodo-titolo" class="h2 sfoca-entra" data-anima>Come si lavora.</h2>
      <p class="lede sfoca-entra" data-anima>
        Quattro passaggi, sempre gli stessi. Tecnologia veloce dove serve velocità, decisioni
        umane dove serve una testa.
      </p>
    </div>

    <ol class="pila" data-pila>
      {
        passi.map((p, i) => (
          <li class="carta" data-carta style={`--i:${i}`}>
            <div class="carta-dentro">
              <p class="etichetta numero">{p.n}</p>
              <p class="h3 carta-titolo">{p.titolo}</p>
              <p class="testo-sm carta-testo">{p.testo}</p>
              <p class="etichetta chi">{p.chi}</p>
            </div>
          </li>
        ))
      }

      {/* Tiene il mazzo completo fermo al centro per mezza schermata prima di
          liberarlo. Vuoto e senza ruolo: è spazio, non contenuto. */}
      <li class="respiro" aria-hidden="true"></li>
    </ol>
  </div>
</section>

<style>
  .metodo {
    padding-block: var(--section) 0;
  }

  .intestazione {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
    padding-bottom: clamp(32px, 5vw, 72px);
  }

  .intestazione h2 {
    max-width: 12ch;
  }

  /**
   * Le carte si fermano al centro dello schermo e ci restano finché non è
   * arrivata anche l'ultima.
   *
   * Prima si agganciavano sotto l'intestazione e si liberavano quasi subito:
   * la pila si vedeva per un istante e poi scappava via, che è il contrario di
   * quello che deve fare un mazzo di carte. Adesso ognuna occupa un tratto di
   * scorrimento suo — `--corsa` — e si aggancia alla stessa quota di tutte le
   * altre, così si accumulano invece di scorrere.
   *
   * L'altezza della carta è fissata: serve a calcolare la quota di aggancio
   * che la mette esattamente al centro, e senza un valore certo il centro
   * cambierebbe da una carta all'altra a seconda di quanto testo contiene.
   */
  .pila {
    --altezza: clamp(230px, 30svh, 330px);
    --corsa: 76svh;
    display: block;
  }

  .carta {
    position: sticky;
    /* Stessa quota per tutte: è quello che le fa impilare invece di scorrere.
       L'offset progressivo lascia visibile il bordo di quelle sotto — senza,
       sembra una carta sola che si restringe. */
    top: calc(50svh - var(--altezza) / 2 + var(--i) * 9px);
    height: var(--corsa);
  }

  /**
   * Il respiro finale è un elemento vuoto dopo le carte, e ci sono voluti due
   * tentativi sbagliati per arrivarci.
   *
   * Un elemento agganciato è vincolato alla *content box* del genitore: un
   * `padding-bottom` sulla pila non la allarga, e infatti non cambiava niente.
   * Allungare l'ultima carta invece allunga anche la sua posizione naturale,
   * quindi quella si agganciava e si liberava nello stesso istante — misurati
   * dieci pixel con tutte e quattro ferme.
   *
   * Uno spazio che non appartiene a nessuna carta allunga la content box senza
   * spostare nessuna posizione naturale: è l'unica delle tre cose che sposta
   * davvero il momento in cui il mazzo si libera.
   */
  .respiro {
    height: 60svh;
  }

  /* Il fondo è pieno e non incassato: una carta che si sovrappone a un'altra
     deve coprirla, altrimenti si legge il testo di sotto in trasparenza. */
  .carta-dentro {
    background: var(--paper);
    border: 1px solid var(--rule);
    box-shadow:
      0 -1px 0 var(--rule),
      0 -18px 30px -24px rgba(0, 0, 0, 0.4);
    border-radius: var(--radius-2);
    padding: clamp(24px, 3vw, 44px);
    /* Tutte della stessa altezza: è quello che rende vero il centro calcolato
       sopra, e fa sì che i bordi che sbucano siano paralleli invece che
       sfalsati a caso a seconda della lunghezza del testo. */
    min-height: var(--altezza);
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: var(--sp-3) clamp(16px, 3vw, 40px);
    align-content: center;
    align-items: start;
    transform-origin: center top;
    will-change: transform;
  }

  .numero {
    grid-row: 1 / 3;
    color: var(--ink-3);
  }

  .carta-titolo {
    grid-column: 2;
  }

  .carta-testo {
    grid-column: 2;
    max-width: 52ch;
  }

  .chi {
    grid-column: 3;
    grid-row: 1;
    color: var(--ink-3);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    /* Niente aggancio sotto i 768px: diventa un elenco, e senza l'altezza
       fissa che serviva solo a calcolare il centro. */
    .pila {
      display: grid;
      gap: var(--sp-4);
      padding-bottom: 0;
    }

    .carta {
      position: static;
      height: auto;
    }

    .carta-dentro {
      min-height: 0;
    }

    /* Senza aggancio non c'è niente da tenere fermo: resterebbe mezza
       schermata di vuoto in fondo a un elenco. */
    .respiro {
      display: none;
    }

    .carta-dentro {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }

    .numero,
    .carta-titolo,
    .carta-testo,
    .chi {
      grid-column: 1;
      grid-row: auto;
    }

    .chi {
      margin-top: var(--sp-2);
    }
  }
</style>

<script>
  import { caricaGsap, movimentoRiccoAmmesso } from '../../lib/movimento.ts';

  function montaPila() {
    const pila = document.querySelector<HTMLElement>('[data-pila]');
    if (!pila || pila.dataset.montato !== undefined) return;
    if (!movimentoRiccoAmmesso()) return;

    pila.dataset.montato = 'si';

    const carte = Array.from(pila.querySelectorAll<HTMLElement>('[data-carta]'));

    caricaGsap().then(({ gsap }) => {
      carte.forEach((carta, i) => {
        // L'ultima non ha nessuno che le salga sopra: resta com'è.
        if (i === carte.length - 1) return;
        const dentro = carta.querySelector<HTMLElement>('.carta-dentro');
        if (!dentro) return;

        /* Niente scurimento. La versione precedente portava la prima carta a
           brightness 0,18: la profondità si vedeva benissimo e il testo non si
           leggeva più. La pila si capisce dal bordo che sbuca e dalla scala —
           che restano leggibili anche a chi ha poca vista, cosa che un testo
           grigio su grigio non fa. */
        /* Finisce quando la carta successiva raggiunge il centro, cioè nel
           momento esatto in cui la copre: legare la fine a "top top" — com'era
           prima che le carte si agganciassero al centro — la faceva rimpicciolire
           molto dopo essere già stata coperta. */
        gsap.to(dentro, {
          scale: 0.95,
          ease: 'none',
          scrollTrigger: {
            trigger: carte[i + 1],
            start: 'top bottom',
            end: 'top center',
            scrub: true,
            invalidateOnRefresh: true,
          },
        });
      });
    });
  }

  montaPila();
  document.addEventListener('astro:page-load', montaPila);
</script>
