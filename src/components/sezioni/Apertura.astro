---
/**
 * Frame 01 — l'apertura.
 *
 * Solo parole. L'immagine c'era e se n'è andata: una schermata di sito lì
 * costringeva il titolo in mezza pagina, e un titolo in mezza pagina non apre
 * niente. Le schermate stanno nella vetrina, che è il posto dove si guardano.
 *
 * Il titolo è testo vero nel DOM dal primo disegno: l'otturatore lavora sul
 * ritaglio, non sull'opacità del contenuto, così l'elemento che Google misura
 * non aspetta nessuna animazione.
 */
import Bottone from '../comuni/Bottone.astro';
import Icona from '../comuni/Icona.astro';
---

<section class="apertura">
  <div class="contenitore dentro">
    <p class="etichetta zona">
      <span class="pulsa" aria-hidden="true"></span>
      Sviluppatore web — Vercelli · Casale Monferrato · Novara · Chivasso
    </p>

    {/*
      Diceva «Il tuo locale», e per un anno è stata la riga più forte del sito.
      Il problema è che era anche la più stretta: chi ha uno studio, chi fa
      consulenza, chi lavora solo online legge «locale» e pensa a bar e
      pizzerie, cioè capisce che il sito non parla a lui — al primo schermo,
      prima di qualsiasi altra cosa.

      «Lavoro» tiene la stessa immagine e lo stesso passo, e non esclude
      nessuno: ce l'hanno tutti, con o senza una porta da aprire la mattina.
    */}
    <h1 class="titolo otturatore" data-anima>
      <span class="riga"><span>Il tuo lavoro</span></span>
      <span class="riga"><span>ha una faccia.</span></span>
      <span class="riga"><span class="chiaro">Il sito deve</span></span>
      <span class="riga"><span class="chiaro">avere quella.</span></span>
    </h1>

    <div class="coda">
      {/*
        L'elenco che segue esiste per farsi riconoscere: chi non si vede
        nominato smette di leggere. Per questo finisce su chi non ha una sede,
        che è il caso che il vecchio testo lasciava fuori del tutto.
      */}
      <p class="lede sfoca-entra" data-anima>
        Vale per un ristorante come per un negozio, uno studio, un'impresa artigianale o una
        consulenza che lavora solo online: ti serve una presenza che faccia capire, in pochi
        secondi, perché qualcuno dovrebbe scegliere te e non il primo altro nome che trova.
      </p>

      <div class="inviti sfoca-entra" data-anima>
        <Bottone href="/contatti">Parliamo del tuo progetto</Bottone>
        <Bottone href="/progetti" variante="fantasma">Guarda i lavori</Bottone>
        <span class="etichetta gratis">Prima mezz'ora senza impegno</span>
      </div>
    </div>

    <p class="scendi etichetta" aria-hidden="true">
      <Icona nome="freccia-giu" dimensione={16} />
      Continua
    </p>
  </div>
</section>

<style>
  .apertura {
    padding-block: clamp(24px, 3.5vw, 52px) clamp(32px, 5vw, 64px);
  }

  .dentro {
    display: grid;
    gap: clamp(20px, 3vw, 40px);
  }

  .zona {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
  }

  /* Un punto che respira: dice che il sito è vivo e che qualcuno risponde.
     È l'unica cosa in movimento continuo di tutta la pagina — di più
     diventerebbe rumore. */
  .pulsa {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--signal);
    flex: 0 0 auto;
    animation: respiro 2.6s var(--ease-inout) infinite;
  }

  @keyframes respiro {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 55%, transparent);
    }
    70% {
      opacity: 0.75;
      box-shadow: 0 0 0 7px transparent;
    }
  }

  /* Più grande della scala: l'apertura è l'unico punto del sito dove il titolo
     ha il permesso di essere enorme.

     La dimensione è legata anche all'altezza della finestra, non solo alla
     larghezza. Con la sola larghezza, su uno schermo largo e basso — cioè
     qualunque portatile — quattro righe da 148px non ci stavano e l'ultima
     finiva sotto la piega: un titolo tagliato a metà è peggio di un titolo
     più piccolo. `11svh` per riga, quattro righe, fa il 40% dell'altezza:
     resta spazio per l'occhiello, il sommario e i bottoni. */
  .titolo {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(38px, min(9.2vw, 9.6svh), 132px);
    line-height: 0.92;
    letter-spacing: -0.05em;
    max-width: 14ch;
    margin: 0;
  }

  /* Le due righe che portano la promessa restano piene; le prime due sono la
     premessa e stanno un gradino indietro. */
  .chiaro {
    color: var(--ink-2);
  }

  .riga {
    display: block;
    overflow: hidden;
  }

  .riga > span {
    display: block;
  }

  .coda {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    padding-top: clamp(16px, 2.4vw, 32px);
    border-top: 1px solid var(--rule);
  }

  .lede {
    max-width: 44ch;
    margin: 0;
  }

  .inviti {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-4);
    justify-content: flex-end;
  }

  .gratis {
    color: var(--ink-3);
  }

  /* Sta sul bordo della piega di proposito: è l'invito a scorrere, e se
     stesse comodamente dentro non inviterebbe a niente. Su finestre basse
     sparisce, perché lì lo spazio serve al titolo. */
  .scendi {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--ink-3);
    margin-top: var(--sp-3);
  }

  @media (max-height: 720px) {
    .scendi {
      display: none;
    }
  }

  .scendi :global(.icona) {
    animation: scendi 2.4s var(--ease-inout) infinite;
  }

  @keyframes scendi {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (max-width: 900px) {
    .coda {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .inviti {
      justify-content: flex-start;
    }

    .titolo {
      max-width: 12ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulsa,
    .scendi :global(.icona) {
      animation: none;
    }
  }
</style>
