---
/**
 * Frame 01 — l'apertura.
 *
 * Solo parole. L'immagine c'era e se n'è andata: una schermata di sito lì
 * costringeva il titolo in mezza pagina, e un titolo in mezza pagina non apre
 * niente. Le schermate stanno nella vetrina, che è il posto dove si guardano.
 *
 * Niente animazioni d'entrata qui: titolo, sommario e bottoni sono visibili
 * dal primo disegno. Con l'otturatore e la sfocatura il contenuto principale
 * arrivava 1,1–1,4 secondi dopo (PageSpeed, 19/11/2026) e chi apriva la pagina
 * vedeva per un attimo un riquadro vuoto. Le comparse restano dalla seconda
 * sezione in giù.
 *
 * Il bottone principale è l'analisi gratuita: chi arriva qui spesso non è
 * pronto per un preventivo, ma un parere gratis sul suo sito lo chiede
 * volentieri (guida 09). Il preventivo resta il secondo bottone.
 */
import Bottone from '../comuni/Bottone.astro';
import Icona from '../comuni/Icona.astro';
import Prove from '../comuni/Prove.astro';
import { SITE } from '../../config.js';
---

<section class="apertura">
  <div class="contenitore dentro">
    <p class="etichetta zona">
      <span class="pulsa" aria-hidden="true"></span>
      <span>
        Sviluppatore web —
        {/* Le città sono link alle loro pagine: la home non compete più con
            loro sulle ricerche «siti web <città>», le manda avanti. */}
        {Object.entries(SITE.pagineZona).map(([nome, href], i) => (
          <>{i > 0 && ' · '}<a href={href}>{nome}</a></>
        ))}
      </span>
    </p>

    <h1 class="titolo">
      <span class="riga"><span>Siti web per</span></span>
      <span class="riga"><span>farti trovare</span></span>
      <span class="riga"><span class="chiaro">da chi cerca</span></span>
      <span class="riga"><span class="chiaro">quello che fai.</span></span>
    </h1>

    <div class="coda">
      {/*
        Il titolo parla del risultato (farsi trovare) e non nomina città, così
        non esclude nessuno. Le città stanno qui sotto, come un'area («da
        Vercelli a Novara e da Casale a Chivasso») e non come un elenco: chi sta
        in un comune in mezzo si sente dentro.
      */}
      <p class="lede">
        Cantine, agriturismi, ristoranti, negozi e artigiani, dalle colline del Monferrato
        fino a Vercelli e Novara: un sito su misura che fa capire in pochi secondi perché
        scegliere te, e non quello accanto.
      </p>

      <div class="inviti">
        <Bottone href="/analisi-gratuita">Richiedi l'analisi gratuita</Bottone>
        <Bottone href="/contatti" variante="fantasma">Parliamo del tuo progetto</Bottone>
      </div>
    </div>

    {/* I tre fatti che distinguono il servizio, subito sotto i bottoni: prima
        stavano solo nella descrizione per Google, che il visitatore non vede. */}
    <div class="garanzie">
      <p class="fatti testo-sm">
        <span>Prezzo detto alla prima risposta</span>
        <span>Dominio intestato a te</span>
        <span>Nessun canone obbligatorio</span>
      </p>
      <Prove />
    </div>

    <p class="scendi etichetta" aria-hidden="true">
      <Icona nome="freccia-giu" dimensione={16} />
      Continua
    </p>
  </div>
</section>

<style>
  .apertura {
    padding-block: clamp(24px, 3.5vw, 52px) clamp(32px, 5vw, 64px);
  }

  .dentro {
    display: grid;
    gap: clamp(20px, 3vw, 40px);
  }

  .zona {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
  }

  /* Un punto che respira: dice che il sito è vivo e che qualcuno risponde.
     È l'unica cosa in movimento continuo di tutta la pagina — di più
     diventerebbe rumore. */
  .pulsa {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--signal);
    flex: 0 0 auto;
    animation: respiro 2.6s var(--ease-inout) infinite;
  }

  @keyframes respiro {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 55%, transparent);
    }
    70% {
      opacity: 0.75;
      box-shadow: 0 0 0 7px transparent;
    }
  }

  /* Più grande della scala: l'apertura è l'unico punto del sito dove il titolo
     ha il permesso di essere enorme.

     La dimensione è legata anche all'altezza della finestra, non solo alla
     larghezza. Con la sola larghezza, su uno schermo largo e basso — cioè
     qualunque portatile — quattro righe da 148px non ci stavano e l'ultima
     finiva sotto la piega: un titolo tagliato a metà è peggio di un titolo
     più piccolo. `11svh` per riga, quattro righe, fa il 40% dell'altezza:
     resta spazio per l'occhiello, il sommario e i bottoni. */
  .titolo {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(38px, min(9.2vw, 9.6svh), 132px);
    line-height: 0.92;
    letter-spacing: -0.05em;
    max-width: 14ch;
    margin: 0;
  }

  /* Le due righe che portano la promessa restano piene; le prime due sono la
     premessa e stanno un gradino indietro. */
  .chiaro {
    color: var(--ink-2);
  }

  .riga {
    display: block;
    overflow: hidden;
  }

  .riga > span {
    display: block;
  }

  .coda {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    padding-top: clamp(16px, 2.4vw, 32px);
    border-top: 1px solid var(--rule);
  }

  .lede {
    max-width: 44ch;
    margin: 0;
  }

  .inviti {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-4);
    justify-content: flex-end;
  }

  .zona a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .zona a:hover {
    color: var(--signal-ink);
    border-bottom-color: var(--signal-ink);
  }

  .garanzie {
    display: grid;
    gap: var(--sp-3);
  }

  .fatti {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    margin: 0;
    color: var(--ink);
    font-weight: 500;
  }

  .fatti span {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .fatti span::before {
    content: '✓';
    color: var(--signal-ink);
    font-weight: 600;
  }

  /* Sta sul bordo della piega di proposito: è l'invito a scorrere, e se
     stesse comodamente dentro non inviterebbe a niente. Su finestre basse
     sparisce, perché lì lo spazio serve al titolo. */
  .scendi {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--ink-3);
    margin-top: var(--sp-3);
  }

  @media (max-height: 720px) {
    .scendi {
      display: none;
    }
  }

  .scendi :global(.icona) {
    animation: scendi 2.4s var(--ease-inout) infinite;
  }

  @keyframes scendi {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (max-width: 900px) {
    .coda {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .inviti {
      justify-content: flex-start;
    }

    .titolo {
      max-width: 12ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulsa,
    .scendi :global(.icona) {
      animation: none;
    }
  }
</style>
