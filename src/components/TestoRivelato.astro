---
/**
 * Testo che si accende parola per parola mentre scorri: le parole partono
 * spente e prendono luce man mano che il blocco attraversa lo schermo.
 *
 * Costa zero JavaScript. La divisione in parole avviene qui, al momento della
 * generazione del sito, e il resto lo fa `animation-timeline: view()`, cioè
 * un'animazione che il browser lega allo scorrimento e manda avanti sul
 * compositore. Nessun listener, nessun IntersectionObserver, nessun rAF: se
 * l'utente scorre veloce, l'animazione lo segue senza poter scattare, perché
 * non c'è codice mio in mezzo.
 *
 * Dove `animation-timeline` non esiste ancora — Firefox al momento — le regole
 * dentro @supports non si applicano e il testo resta semplicemente leggibile,
 * a piena opacità. Non è un ripiego: è lo stato predefinito.
 *
 * Il testo arriva come stringa e non come slot proprio perché va spezzato: uno
 * slot potrebbe contenere marcatura, e dividere HTML per spazi lo romperebbe.
 */
interface Props {
  testo: string;
  /** Elemento da generare. Un paragrafo quasi sempre, a volte un h2. */
  as?: 'p' | 'h2' | 'h3' | 'blockquote';
  class?: string;
}

const { testo, as: Tag = 'p', class: classe = '' } = Astro.props;

const parole = testo.trim().split(/\s+/);
---

<Tag class:list={['testo-rivelato', classe]} style={`--n:${parole.length}`}>
  {
    parole.map((parola, i) => (
      <>
        <span class="parola" style={`--i:${i}`}>{parola}</span>{' '}
      </>
    ))
  }
</Tag>

<style>
  .testo-rivelato {
    text-wrap: pretty;
  }
  /* inline-block per non far spezzare una parola a metà fra due righe:
     l'unità che si accende deve restare intera. Lo spazio fra le parole sta
     fuori dagli span, quindi il testo si può ancora selezionare e copiare
     normalmente, e i lettori di schermo leggono una frase sola. */
  .parola {
    display: inline-block;
    will-change: opacity, filter, transform;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .testo-rivelato {
        /* La linea temporale è quella del blocco intero: le parole ci si
           agganciano con un ritardo proporzionale alla loro posizione. */
        view-timeline-name: --rivelazione;
        view-timeline-axis: block;
      }

      .parola {
        animation: parola-accende linear both;
        animation-timeline: --rivelazione;
        /* Ogni parola si accende in una finestra del 26%, spostata in avanti
           in proporzione alla sua posizione nella frase: due o tre sono
           sempre a metà strada, e l'effetto è un'onda invece che un semaforo.
           Il fattore 62% lascia l'ultima parola accesa prima che il blocco
           esca di scena — un testo che finisce di illuminarsi quando è già
           sparito non lo legge nessuno.

           Il nome dell'intervallo sta fuori dal calc: dentro andrebbero solo
           le lunghezze, e `calc(entry 22% + …)` non è una espressione valida. */
        animation-range-start: entry calc(18% + (var(--i) / var(--n)) * 46%);
        animation-range-end: entry calc(40% + (var(--i) / var(--n)) * 46%);
      }
    }
  }

  /* Non solo opacità: le parole arrivano fuori fuoco, leggermente più in
     basso e appena più piccole, e si sistemano passando. La sola dissolvenza
     era troppo timida per accorgersene mentre si scorre. */
  @keyframes parola-accende {
    from {
      opacity: 0.12;
      filter: blur(6px);
      transform: translateY(0.14em) scale(0.97);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }
</style>
