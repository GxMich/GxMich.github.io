---
/**
 * Piede.
 *
 * Nero, con il nome in grande sul fondo: è la firma, e sta dietro al contenuto
 * invece che accanto, così non ruba spazio a quello che serve davvero — i
 * recapiti. Il nome è decorativo, quindi sparisce ai lettori di schermo: il
 * nome vero, leggibile, sta nella riga in fondo.
 *
 * Zero effetti sul contenuto: è l'ultima cosa che vede chi non ha ancora
 * deciso, e deve dare i contatti senza far aspettare niente.
 */
import { SITE, NAVIGAZIONE } from '../../config.js';

const anno = new Date().getFullYear();
---

<footer class="piede su-palco">
  {/*
    Il nome come SVG e non come testo.
    Con `font-size` legata alla larghezza della finestra il nome usciva dai
    bordi e si vedeva a metà: bastava una finestra un po' stretta. Qui
    `textLength` lo costringe alla larghezza esatta del riquadro e il riquadro
    si adatta al contenitore, quindi è sempre intero, a qualsiasi misura.
  */}
  <svg
    class="firma"
    viewBox="0 0 1000 128"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
    focusable="false"
  >
    <text x="0" y="100" textLength="1000" lengthAdjust="spacingAndGlyphs">Modica Michele</text>
  </svg>

  <div class="contenitore dentro">
    <div class="colonna primaria">
      <p class="etichetta">Parliamone</p>
      <p class="contatto">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      <p class="contatto">
        <a href={`https://wa.me/${SITE.whatsapp}`}>{SITE.whatsappLabel}</a>
      </p>

      {/*
        L'indirizzo in chiaro, con il tag che lo dichiara per quello che è.

        Non è arredamento: perché una scheda Google e un sito si riconoscano
        come la stessa attività, il nome, il luogo e il telefono devono essere
        scritti uguali nei due posti. Qui c'è comune, CAP e regione — la via di
        casa no, perché non è una sede in cui si entra e dichiararne una che
        non esiste è la cosa che Google punisce più volentieri.
      */}
      <address class="dove testo-sm">
        {SITE.city} ({SITE.provincia}), {SITE.cap} — {SITE.region}
      </address>

      <p class="testo-sm nota">La prima mezz'ora non si paga.</p>
    </div>

    <div class="colonna">
      <p class="etichetta">Pagine</p>
      <ul class="elenco">
        <li><a href="/">Home</a></li>
        {NAVIGAZIONE.map((v) => <li><a href={v.href}>{v.etichetta}</a></li>)}
      </ul>
    </div>

    <div class="colonna">
      <p class="etichetta">Dove lavoro</p>
      {/* Le città che hanno una pagina diventano link, le altre restano testo:
          così l'elenco non promette pagine che non esistono. */}
      <ul class="elenco spento">
        {
          SITE.areas.map((a) => (
            <li>
              {SITE.pagineZona[a] ? <a href={SITE.pagineZona[a]}>{a}</a> : a}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="colonna">
      <p class="etichetta">Altrove</p>
      <ul class="elenco">
        {/*
          La scheda Google in cima e con il nome per esteso, non con il suo
          dominio come gli altri: è l'unico link di questa colonna che serve a
          qualcosa a chi legge — è lì che si vedono la mappa e le recensioni.
        */}
        {
          SITE.google && (
            <li>
              <a href={SITE.google} rel="me noopener" target="_blank">
                Scheda Google
              </a>
            </li>
          )
        }
        {
          SITE.profili.map((url) => (
            <li>
              <a href={url} rel="me noopener" target="_blank">
                {new URL(url).hostname.replace('www.', '')}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="contenitore coda">
    <p class="etichetta">
      © {anno} {SITE.name} — {SITE.city} ({SITE.provincia})
    </p>
    {/* Il ripensamento deve stare dove sta la privacy, non tre clic più in
        là: ritirare il consenso deve costare quanto darlo. */}
    <p class="etichetta legami">
      <a href="/privacy">Privacy</a>
      <button type="button" data-cambia-consenso>Misure di traffico</button>
    </p>
  </div>
</footer>

<style>
  .piede {
    position: relative;
    isolation: isolate;
    background: var(--stage);
    color: var(--light);
    margin-top: var(--section);
    padding-block: var(--sp-9) var(--sp-6);
    overflow: hidden;
  }

  .firma {
    position: absolute;
    inset: auto var(--gutter) var(--sp-5);
    z-index: -1;
    width: calc(100% - var(--gutter) * 2);
    height: auto;
    opacity: 0.08;
    user-select: none;
  }

  .firma text {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 120px;
    fill: var(--light);
  }

  .dentro {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: var(--sp-8) var(--col-gap);
  }

  .colonna {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
  }

  .colonna .etichetta {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--edge);
    margin-bottom: var(--sp-1);
  }

  .contatto {
    font-size: var(--t-h4);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .contatto a {
    text-decoration: none;
    border-bottom: 1px solid var(--edge);
    padding-bottom: 2px;
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .contatto a:hover {
    border-bottom-color: var(--signal);
  }

  .dove {
    font-style: normal;
    color: var(--light-2);
    margin-top: var(--sp-2);
  }

  .nota {
    margin-top: var(--sp-2);
  }

  .elenco {
    display: grid;
    gap: var(--sp-2);
    font-size: var(--t-body-sm);
  }

  .elenco a {
    text-decoration: none;
    color: var(--light-2);
    transition: color var(--dur-1) var(--ease-out);
  }

  .elenco a:hover {
    color: var(--light);
  }

  .elenco.spento {
    color: var(--light-2);
  }

  .coda {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-9);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--edge);
  }

  .coda a {
    color: inherit;
  }

  .legami {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
  }

  .legami button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out);
  }

  .legami button:hover {
    color: var(--light);
  }

  @media (max-width: 1023px) {
    .dentro {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .dentro {
      grid-template-columns: 1fr;
      gap: var(--sp-7);
    }

    .firma {
      opacity: 0.11;
    }
  }
</style>
