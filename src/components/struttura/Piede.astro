---
/**
 * Piede.
 *
 * Nero, con il nome in grande sul fondo: è la firma, e sta dietro al contenuto
 * invece che accanto, così non ruba spazio a quello che serve davvero — i
 * recapiti. Il nome è decorativo, quindi sparisce ai lettori di schermo: il
 * nome vero, leggibile, sta nella riga in fondo.
 *
 * Zero effetti sul contenuto: è l'ultima cosa che vede chi non ha ancora
 * deciso, e deve dare i contatti senza far aspettare niente.
 */
import { SITE, NAVIGAZIONE } from '../../config.js';

const anno = new Date().getFullYear();
---

<footer class="piede su-palco">
  <span class="firma" aria-hidden="true">Modica Michele</span>

  <div class="contenitore dentro">
    <div class="colonna primaria">
      <p class="etichetta">Parliamone</p>
      <p class="contatto">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      <p class="contatto">
        <a href={`https://wa.me/${SITE.whatsapp}`}>{SITE.whatsappLabel}</a>
      </p>
      <p class="testo-sm nota">La prima mezz'ora non si paga.</p>
    </div>

    <div class="colonna">
      <p class="etichetta">Pagine</p>
      <ul class="elenco">
        <li><a href="/">Home</a></li>
        {NAVIGAZIONE.map((v) => <li><a href={v.href}>{v.etichetta}</a></li>)}
      </ul>
    </div>

    <div class="colonna">
      <p class="etichetta">Dove lavoro</p>
      <ul class="elenco spento">
        {SITE.areas.map((a) => <li>{a}</li>)}
      </ul>
    </div>

    <div class="colonna">
      <p class="etichetta">Altrove</p>
      <ul class="elenco">
        {
          SITE.profili.map((url) => (
            <li>
              <a href={url} rel="me noopener" target="_blank">
                {new URL(url).hostname.replace('www.', '')}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="contenitore coda">
    <p class="etichetta">
      © {anno} {SITE.name} — {SITE.city} ({SITE.provincia})
    </p>
    <p class="etichetta">
      <a href="/privacy">Privacy</a>
    </p>
  </div>
</footer>

<style>
  .piede {
    position: relative;
    isolation: isolate;
    background: var(--stage);
    color: var(--light);
    margin-top: var(--section);
    padding-block: var(--sp-9) var(--sp-6);
    overflow: hidden;
  }

  /* Il nome riempie l'altezza del piede e resta dietro a tutto. `1lh` di
     interlinea con la dimensione legata alla larghezza della finestra: cresce
     con lo schermo senza mai andare a capo. */
  .firma {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    place-items: center;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(52px, 15.5vw, 250px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    white-space: nowrap;
    color: var(--light);
    opacity: 0.07;
    user-select: none;
  }

  .dentro {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: var(--sp-8) var(--col-gap);
  }

  .colonna {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
  }

  .colonna .etichetta {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--edge);
    margin-bottom: var(--sp-1);
  }

  .contatto {
    font-size: var(--t-h4);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .contatto a {
    text-decoration: none;
    border-bottom: 1px solid var(--edge);
    padding-bottom: 2px;
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .contatto a:hover {
    border-bottom-color: var(--signal);
  }

  .nota {
    margin-top: var(--sp-2);
  }

  .elenco {
    display: grid;
    gap: var(--sp-2);
    font-size: var(--t-body-sm);
  }

  .elenco a {
    text-decoration: none;
    color: var(--light-2);
    transition: color var(--dur-1) var(--ease-out);
  }

  .elenco a:hover {
    color: var(--light);
  }

  .elenco.spento {
    color: var(--light-2);
  }

  .coda {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-9);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--edge);
  }

  .coda a {
    color: inherit;
  }

  @media (max-width: 1023px) {
    .dentro {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .dentro {
      grid-template-columns: 1fr;
      gap: var(--sp-7);
    }

    .firma {
      /* Su telefono il nome intero su una riga sola diventa illeggibilmente
         piccolo: va a capo, e l'interlinea stretta lo tiene compatto. */
      white-space: normal;
      font-size: clamp(56px, 22vw, 120px);
      line-height: 0.86;
      text-align: center;
    }
  }
</style>
