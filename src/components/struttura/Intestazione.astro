---
/**
 * Intestazione e menu a schermo intero.
 *
 * Due stati e una sola barra.
 *
 *  - In cima: larga quanto il contenuto, trasparente, col nome per esteso.
 *    C'è spazio, e un nome scritto per intero lavora meglio di una sigla.
 *  - Scorrendo: si stacca e diventa un'isola stretta, il nome si richiude
 *    sul segno e attorno al segno compare l'anello che dice quanto manca alla
 *    fine della pagina.
 *
 * L'isola usa `--ink` come fondo, quindi si inverte da sola col tema: scura
 * sulla carta chiara, chiara sul nero — senza una seconda regola da tenere
 * allineata a mano.
 *
 * Sopra 1024px le voci restano visibili. Su un pubblico che sta valutando se
 * chiamarti, nascondere la navigazione dietro un'icona è un costo di
 * conversione, non una scelta estetica.
 */
import { SITE, NAVIGAZIONE } from '../../config.js';
import Icona from '../comuni/Icona.astro';
import Tema from '../comuni/Tema.astro';

const percorso = Astro.url.pathname.replace(/\/$/, '') || '/';
const attiva = (href: string) => percorso === href || percorso.startsWith(href + '/');
const principali = NAVIGAZIONE.filter((v) => v.principale);
---

{/* La sentinella misura lo scorrimento senza un ascoltatore su `scroll`. */}
<div data-sentinella aria-hidden="true"></div>

<header class="intestazione" data-intestazione>
  <div class="contenitore guscio">
    <div class="barra">
      <a class="marchio" href="/" aria-label={`${SITE.name} — torna alla home`}>
        <span class="segno" aria-hidden="true">
          <span class="bollo"></span>
          {/* L'anello si riempie con lo scorrimento: dice quanto manca senza
              aggiungere una barra che ruba una riga alla pagina. */}
          <span class="anello" data-anello></span>
        </span>
        <span class="nome" aria-hidden="true">
          <span class="nome-lungo">Michele Modica</span>
          <span class="nome-corto">MM</span>
        </span>
      </a>

      <nav class="voci" aria-label="Navigazione principale" data-voci>
        {/* Un indicatore solo che scivola, invece di un bordo acceso su
            ciascuna: si vede da dove viene e dove va. */}
        <span class="cursore" data-cursore aria-hidden="true"></span>
        {
          principali.map((v) => (
            <a
              href={v.href}
              aria-current={attiva(v.href) ? 'page' : undefined}
              data-voce={attiva(v.href) ? 'attiva' : ''}
            >
              <span class="scambio">
                <span>{v.etichetta}</span>
                <span aria-hidden="true">{v.etichetta}</span>
              </span>
            </a>
          ))
        }
      </nav>

      <div class="coda">
        <Tema />

        <a class="invito" href="/contatti">
          <span class="invito-testo">Parliamone</span>
          <span class="invito-segno"><Icona nome="freccia" dimensione={15} /></span>
        </a>

        <button
          class="apri"
          type="button"
          data-apri
          aria-expanded="false"
          aria-controls="menu-principale"
        >
          <span class="solo-lettori">Apri il menu</span>
          <Icona nome="menu" dimensione={22} />
        </button>
      </div>
    </div>
  </div>
</header>

<div class="menu" id="menu-principale" data-menu inert>
  <button class="chiudi" type="button" data-chiudi>
    <span class="solo-lettori">Chiudi il menu</span>
    <Icona nome="chiudi" dimensione={22} />
  </button>

  <div class="contenitore menu-dentro">
    <nav aria-label="Menu">
      <ul class="menu-voci">
        <li class="riga" style="--i:0">
          <a href="/" aria-current={percorso === '/' ? 'page' : undefined}>
            <span class="indice dato">00</span>Home
          </a>
        </li>
        {
          NAVIGAZIONE.map((v, i) => (
            <li class="riga" style={`--i:${i + 1}`}>
              <a href={v.href} aria-current={attiva(v.href) ? 'page' : undefined}>
                <span class="indice dato">{String(i + 1).padStart(2, '0')}</span>
                {v.etichetta}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-piede" style={`--i:${NAVIGAZIONE.length + 1}`}>
      <p class="riga"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p class="riga"><a href={`https://wa.me/${SITE.whatsapp}`}>{SITE.whatsappLabel}</a></p>
      <p class="riga etichetta">{SITE.city} · {SITE.provincia} — e da remoto</p>
    </div>
  </div>
</div>

<style>
  /* ----------------------------- intestazione ----------------------------- */
  .intestazione {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
  }

  .guscio {
    transition: padding var(--dur-3) var(--ease-out);
  }

  .barra {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    height: 72px;
    padding-inline: 0;
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    transition:
      height var(--dur-3) var(--ease-out),
      max-width var(--dur-3) var(--ease-out),
      padding var(--dur-3) var(--ease-out),
      background-color var(--dur-3) var(--ease-out),
      color var(--dur-3) var(--ease-out),
      border-radius var(--dur-3) var(--ease-out),
      box-shadow var(--dur-3) var(--ease-out),
      transform var(--dur-3) var(--ease-out);
  }

  /* ------------------------------- l'isola ------------------------------- */
  .intestazione[data-scorsa] .guscio {
    padding-top: var(--sp-3);
  }

  .intestazione[data-scorsa] .barra {
    max-width: 860px;
    margin-inline: auto;
    height: 56px;
    padding-inline: 10px;
    gap: var(--sp-4);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--paper) 12%, transparent) inset,
      0 14px 38px -20px rgba(0, 0, 0, 0.6);
  }

  /* ------------------------------ il marchio ------------------------------ */
  .marchio {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    color: inherit;
    margin-right: auto;
    padding: 4px;
    border-radius: 999px;
  }

  .segno {
    position: relative;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
  }

  .bollo {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: linear-gradient(140deg, #ff9a70, var(--signal));
    transition:
      transform var(--dur-2) var(--ease-out),
      width var(--dur-3) var(--ease-out),
      height var(--dur-3) var(--ease-out);
  }

  .marchio:hover .bollo {
    transform: scale(1.1) rotate(14deg);
  }

  /* La maschera lascia vedere solo la corona: dentro resta il segno. */
  .anello {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: conic-gradient(
      var(--signal) calc(var(--avanzamento, 0) * 360deg),
      color-mix(in srgb, currentColor 22%, transparent) 0
    );
    -webkit-mask: radial-gradient(closest-side, transparent 80%, #000 81%);
    mask: radial-gradient(closest-side, transparent 80%, #000 81%);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .intestazione[data-scorsa] .anello {
    opacity: 1;
  }

  .intestazione[data-scorsa] .bollo {
    width: 20px;
    height: 20px;
  }

  /* Il nome si richiude sul segno: `max-width` invece di `display:none`, così
     la chiusura si vede invece di essere uno scatto. */
  .nome {
    display: flex;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.02em;
    max-width: 200px;
    transition:
      max-width var(--dur-3) var(--ease-out),
      opacity var(--dur-2) var(--ease-out);
  }

  .nome-corto {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    opacity: 0;
    width: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  /* Solo su schermo largo: sotto i 1024px il nome è già ridotto alla sigla, e
     richiuderlo lascerebbe il marchio senza nessuna etichetta. */
  @media (min-width: 1024px) {
    .intestazione[data-scorsa] .nome {
      max-width: 0;
      opacity: 0;
    }
  }

  /* ------------------------------- le voci ------------------------------- */
  .voci {
    position: relative;
    display: flex;
    gap: var(--sp-2);
  }

  .intestazione[data-scorsa] .voci {
    margin-inline: auto;
  }

  .voci a {
    position: relative;
    text-decoration: none;
    font-size: var(--t-body-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, currentColor 62%, transparent);
    padding: 8px 14px;
    border-radius: 999px;
    transition: color var(--dur-1) var(--ease-out);
  }

  .voci a:hover,
  .voci a[aria-current='page'] {
    color: currentColor;
  }

  /* Il cursore sta sotto le voci e si sposta: la posizione la calcola lo
     script, qui c'è solo come si muove. */
  .cursore {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 9%, transparent);
    opacity: 0;
    transform: translateX(var(--x, 0));
    width: var(--w, 0);
    transition:
      transform var(--dur-2) var(--ease-out),
      width var(--dur-2) var(--ease-out),
      opacity var(--dur-1) var(--ease-out);
    pointer-events: none;
  }

  .voci[data-cursore-attivo] .cursore {
    opacity: 1;
  }

  .scambio {
    display: block;
    overflow: hidden;
    height: 1.4em;
    line-height: 1.4em;
  }

  .scambio > span {
    display: block;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .voci a:hover .scambio > span,
  .voci a:focus-visible .scambio > span {
    transform: translateY(-100%);
  }

  /* -------------------------------- la coda ------------------------------- */
  .coda {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  /* Un filetto separa gli strumenti dalla navigazione: senza, il bottone del
     tema sembra una quarta voce di menu. */
  .coda::before {
    content: '';
    width: 1px;
    height: 20px;
    background: color-mix(in srgb, currentColor 18%, transparent);
    margin-right: var(--sp-1);
  }

  .invito {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--t-body-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    background: var(--signal);
    color: var(--signal-on);
    border-radius: 999px;
    padding: 10px 8px 10px 18px;
    white-space: nowrap;
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .invito:hover {
    background: color-mix(in srgb, var(--signal) 86%, #000);
  }

  /* Il segno viaggia dentro una pastiglia sua: al passaggio del mouse la
     pastiglia si schiarisce e la freccia si allunga dentro. */
  .invito-segno {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--signal-on) 12%, transparent);
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .invito:hover .invito-segno {
    background: color-mix(in srgb, var(--signal-on) 20%, transparent);
  }

  .invito :global(.asta) {
    transform: scaleX(0.3);
  }

  .invito:hover :global(.asta) {
    transform: scaleX(1);
  }

  .invito:hover :global(.punta) {
    transform: translateX(2px);
  }

  .apri {
    display: none;
    padding: 8px;
    margin-right: -4px;
    color: inherit;
    border-radius: 999px;
  }

  .apri :global(.tratto) {
    transition: transform var(--dur-2) var(--ease-out);
    transform-origin: 3.5px center;
  }

  .apri:hover :global(.alto) {
    transform: scaleX(0.72);
  }

  .apri:hover :global(.basso) {
    transform: scaleX(0.86);
  }

  .intestazione[data-scorsa] :global(.tema) {
    width: 34px;
    height: 34px;
  }

  .intestazione[data-scorsa] .invito {
    padding: 7px 6px 7px 16px;
  }

  .intestazione[data-scorsa] .invito-segno {
    width: 24px;
    height: 24px;
  }

  /* ------------------------------- menu ---------------------------------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    background: var(--stage);
    color: var(--light);
    display: flex;
    align-items: center;
    clip-path: circle(0% at calc(100% - 40px) 40px);
    visibility: hidden;
    transition:
      clip-path 700ms var(--ease-expo),
      visibility 0s linear 700ms;
  }

  .menu.aperto {
    clip-path: circle(150% at calc(100% - 40px) 40px);
    visibility: visible;
    transition:
      clip-path 700ms var(--ease-expo),
      visibility 0s;
  }

  .chiudi {
    position: absolute;
    top: 18px;
    right: max(var(--gutter), 20px);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--light);
    opacity: 0;
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .menu.aperto .chiudi {
    opacity: 1;
    transition-delay: 320ms;
  }

  .chiudi:hover {
    transform: rotate(90deg);
  }

  .menu-dentro {
    display: grid;
    gap: var(--sp-8);
    width: 100%;
  }

  .menu-voci {
    display: grid;
    gap: var(--sp-2);
  }

  .riga {
    display: block;
    overflow: hidden;
  }

  .riga > * {
    display: block;
    transform: translateY(100%);
    transition: transform 600ms var(--ease-out);
  }

  .menu.aperto .riga > * {
    transform: none;
    transition-delay: calc(385ms + var(--i, 0) * 60ms);
  }

  .menu:not(.aperto) .riga > * {
    transition-delay: 0s;
    transition-duration: var(--dur-2);
  }

  .menu-voci a {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(38px, 11vw, 68px);
    line-height: 1.14;
    letter-spacing: -0.04em;
    text-decoration: none;
    width: fit-content;
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .menu-voci .indice {
    color: var(--light-2);
    font-size: var(--t-label);
    transition: color var(--dur-2) var(--ease-out);
  }

  .menu-voci a:hover {
    transform: translateX(14px);
    color: var(--signal);
  }

  .menu-voci a:hover .indice {
    color: var(--signal);
  }

  .menu-voci a[aria-current='page'] {
    color: var(--signal);
  }

  .menu-piede {
    display: grid;
    gap: var(--sp-2);
    font-size: var(--t-body-sm);
  }

  .menu-piede a {
    text-decoration: none;
    border-bottom: 1px solid var(--edge);
    padding-bottom: 2px;
  }

  .menu-piede .etichetta {
    color: var(--light-2);
    margin-top: var(--sp-2);
  }

  /* --------------------------- sotto i 1024px ----------------------------- */
  @media (max-width: 1023px) {
    .voci,
    .invito {
      display: none;
    }

    .apri {
      display: grid;
      place-items: center;
    }

    .barra {
      height: 64px;
    }

    /* Su telefono il nome per esteso mangia la barra: resta la sigla. */
    .nome-lungo {
      display: none;
    }

    .nome-corto {
      opacity: 1;
      width: auto;
    }
  }

  :global(html[data-menu-aperto]) .intestazione {
    opacity: 0;
    pointer-events: none;
  }

  :global(html[data-menu-aperto]),
  :global(html[data-menu-aperto] body) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .marchio:hover .bollo,
    .chiudi:hover,
    .menu-voci a:hover {
      transform: none;
    }
  }
</style>

<script>
  /**
   * `astro:page-load` scatta anche al primo caricamento: montare qui e anche
   * subito significherebbe due ascoltatori sullo stesso clic. Il segno sul
   * bottone rende il montaggio ripetibile senza danni.
   */
  function montaIntestazione() {
    const intestazione = document.querySelector<HTMLElement>('[data-intestazione]');
    const sentinella = document.querySelector<HTMLElement>('[data-sentinella]');
    const bottone = document.querySelector<HTMLButtonElement>('[data-apri]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');

    if (!intestazione || !sentinella || !bottone || !menu) return;
    if (bottone.dataset.montato) return;
    bottone.dataset.montato = 'si';

    const osservatore = new IntersectionObserver(
      ([voce]) => intestazione.toggleAttribute('data-scorsa', !voce.isIntersecting),
      { rootMargin: '0px' }
    );
    osservatore.observe(sentinella);

    /* --------------------- il cursore sotto le voci --------------------- */
    const voci = document.querySelector<HTMLElement>('[data-voci]');
    const cursore = document.querySelector<HTMLElement>('[data-cursore]');

    if (voci && cursore) {
      const attiva = voci.querySelector<HTMLElement>('a[aria-current="page"]');

      const posa = (bersaglio: HTMLElement | null) => {
        if (!bersaglio) {
          voci.removeAttribute('data-cursore-attivo');
          return;
        }
        cursore.style.setProperty('--x', `${bersaglio.offsetLeft}px`);
        cursore.style.setProperty('--w', `${bersaglio.offsetWidth}px`);
        voci.setAttribute('data-cursore-attivo', '');
      };

      voci.querySelectorAll<HTMLElement>('a').forEach((a) => {
        a.addEventListener('mouseenter', () => posa(a));
        a.addEventListener('focus', () => posa(a));
      });

      /* Uscendo torna sulla pagina corrente: se non c'è, sparisce invece di
         restare fermo sull'ultima voce toccata. */
      voci.addEventListener('mouseleave', () => posa(attiva));
      voci.addEventListener('focusout', (e) => {
        if (!voci.contains(e.relatedTarget as Node)) posa(attiva);
      });

      posa(attiva);
      /* I caratteri arrivano dopo il primo disegno e cambiano la larghezza
         delle voci: senza questo il cursore resta della misura sbagliata. */
      document.fonts?.ready.then(() => posa(attiva));
      window.addEventListener('resize', () => posa(attiva), { passive: true });
    }

    /* ------------------- l'anello attorno al marchio -------------------- */
    const anello = document.querySelector<HTMLElement>('[data-anello]');
    if (anello) {
      const aggiornaAnello = () => {
        const corsa = document.documentElement.scrollHeight - window.innerHeight;
        const quota = corsa > 0 ? Math.min(1, Math.max(0, window.scrollY / corsa)) : 0;
        anello.style.setProperty('--avanzamento', String(quota));
      };
      window.addEventListener('scroll', aggiornaAnello, { passive: true });
      window.addEventListener('resize', aggiornaAnello, { passive: true });
      aggiornaAnello();
    }

    /* ------------------------------ il menu ----------------------------- */
    const focalizzabili = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter(
        (el) => el.offsetParent !== null
      );

    function apri() {
      menu.classList.add('aperto');
      menu.removeAttribute('inert');
      bottone.setAttribute('aria-expanded', 'true');
      document.documentElement.setAttribute('data-menu-aperto', '');
      focalizzabili()[0]?.focus();
    }

    function chiudi() {
      menu.classList.remove('aperto');
      menu.setAttribute('inert', '');
      bottone.setAttribute('aria-expanded', 'false');
      document.documentElement.removeAttribute('data-menu-aperto');
      /* Sempre al bottone: è il controllo che possiede il menu, ed è dove chi
         naviga da tastiera si aspetta di ritrovarsi. */
      bottone.focus();
    }

    bottone.addEventListener('click', () => {
      menu.classList.contains('aperto') ? chiudi() : apri();
    });

    menu.querySelector<HTMLButtonElement>('[data-chiudi]')?.addEventListener('click', chiudi);

    document.addEventListener('keydown', (e) => {
      if (!menu.classList.contains('aperto')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        chiudi();
        return;
      }

      /* Trappola per il fuoco: senza, il tabulatore esce dal menu e continua a
         scorrere i link della pagina sotto, che è coperta e illeggibile. */
      if (e.key === 'Tab') {
        const elementi = focalizzabili();
        if (elementi.length === 0) return;
        const primo = elementi[0];
        const ultimo = elementi[elementi.length - 1];

        if (e.shiftKey && document.activeElement === primo) {
          e.preventDefault();
          ultimo.focus();
        } else if (!e.shiftKey && document.activeElement === ultimo) {
          e.preventDefault();
          primo.focus();
        }
      }
    });

    document.addEventListener('astro:before-swap', () => {
      if (menu.classList.contains('aperto')) {
        menu.classList.remove('aperto');
        menu.setAttribute('inert', '');
        document.documentElement.removeAttribute('data-menu-aperto');
      }
    });
  }

  montaIntestazione();
  document.addEventListener('astro:page-load', montaIntestazione);
</script>
