---
/**
 * Intestazione e menu a schermo intero.
 *
 * Sono un componente solo perché sono la stessa navigazione in due forme, e
 * tenerli separati vorrebbe dire duplicare l'elenco delle voci.
 *
 * In cima alla pagina la barra è trasparente e larga quanto il contenuto.
 * Appena si scorre si stacca dal bordo e diventa una pastiglia in colore
 * pieno: usa `--ink` come fondo, quindi nel tema chiaro è scura sulla carta e
 * nel tema scuro è chiara sul nero — si inverte da sola senza una seconda
 * regola da tenere allineata.
 *
 * Sopra 1024px le voci restano visibili: su un pubblico che sta valutando se
 * chiamarti, nascondere la navigazione dietro un'icona è un costo di
 * conversione, non una scelta estetica.
 */
import { SITE, NAVIGAZIONE } from '../../config.js';
import Icona from '../comuni/Icona.astro';
import Tema from '../comuni/Tema.astro';

const percorso = Astro.url.pathname.replace(/\/$/, '') || '/';
const attiva = (href: string) => percorso === href || percorso.startsWith(href + '/');
const principali = NAVIGAZIONE.filter((v) => v.principale);
---

{/* La sentinella misura lo scorrimento senza un ascoltatore su `scroll`. */}
<div data-sentinella aria-hidden="true"></div>

<header class="intestazione" data-intestazione>
  <div class="contenitore guscio">
    <div class="barra">
      <a class="marchio" href="/" aria-label={`${SITE.name} — torna alla home`}>
        <span class="bollo" aria-hidden="true"></span>
        <span class="sigla" aria-hidden="true">MM</span>
      </a>

      <nav class="voci" aria-label="Navigazione principale">
        {
          principali.map((v) => (
            <a href={v.href} aria-current={attiva(v.href) ? 'page' : undefined}>
              {/* Due copie sovrapposte: al passaggio del mouse la prima sale e
                  la seconda entra da sotto. */}
              <span class="scambio">
                <span>{v.etichetta}</span>
                <span aria-hidden="true">{v.etichetta}</span>
              </span>
            </a>
          ))
        }
      </nav>

      <div class="coda">
        <Tema />

        <a class="invito" href="/contatti">
          <span>Parliamone</span>
          <Icona nome="freccia" dimensione={15} />
        </a>

        <button
          class="apri"
          type="button"
          data-apri
          aria-expanded="false"
          aria-controls="menu-principale"
        >
          <span class="solo-lettori">Apri il menu</span>
          <Icona nome="menu" dimensione={22} />
        </button>
      </div>
    </div>
  </div>
</header>

<div class="menu" id="menu-principale" data-menu inert>
  <button class="chiudi" type="button" data-chiudi>
    <span class="solo-lettori">Chiudi il menu</span>
    <Icona nome="chiudi" dimensione={22} />
  </button>

  <div class="contenitore menu-dentro">
    <nav aria-label="Menu">
      <ul class="menu-voci">
        {/* La home è la voce che manca in ogni menu fatto male. */}
        <li class="riga" style="--i:0">
          <a href="/" aria-current={percorso === '/' ? 'page' : undefined}>Home</a>
        </li>
        {
          NAVIGAZIONE.map((v, i) => (
            <li class="riga" style={`--i:${i + 1}`}>
              <a href={v.href} aria-current={attiva(v.href) ? 'page' : undefined}>
                {v.etichetta}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-piede" style={`--i:${NAVIGAZIONE.length + 1}`}>
      <p class="riga"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p class="riga"><a href={`https://wa.me/${SITE.whatsapp}`}>{SITE.whatsappLabel}</a></p>
      <p class="riga etichetta">{SITE.city} · {SITE.provincia} — e da remoto</p>
    </div>
  </div>
</div>

<style>
  /* ----------------------------- intestazione ----------------------------- */
  .intestazione {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
  }

  .guscio {
    transition: padding var(--dur-3) var(--ease-out);
  }

  .barra {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    height: var(--header-h);
    padding-inline: 0;
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    transition:
      height var(--dur-3) var(--ease-out),
      padding var(--dur-3) var(--ease-out),
      background-color var(--dur-3) var(--ease-out),
      color var(--dur-3) var(--ease-out),
      border-radius var(--dur-3) var(--ease-out),
      box-shadow var(--dur-3) var(--ease-out);
  }

  /* La pastiglia. `--ink` come fondo si inverte col tema senza una seconda
     regola: scura sulla carta chiara, chiara sul nero. */
  .intestazione[data-scorsa] .guscio {
    padding-top: var(--sp-3);
  }

  .intestazione[data-scorsa] .barra {
    height: 62px;
    padding-inline: var(--sp-5);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 12px 34px -18px rgba(0, 0, 0, 0.55);
  }

  .marchio {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    color: inherit;
    margin-right: auto;
  }

  .bollo {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: linear-gradient(140deg, #ff7a4d, var(--signal));
    transition: transform var(--dur-2) var(--ease-out);
  }

  .marchio:hover .bollo {
    transform: scale(1.12) rotate(12deg);
  }

  .sigla {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 13.5px;
    letter-spacing: 0.06em;
  }

  /* Su schermo largo, con la pastiglia, le voci si centrano davvero: il
     marchio spinge a sinistra e la coda a destra, questa resta in mezzo. */
  .voci {
    display: flex;
    gap: var(--sp-6);
  }

  .intestazione[data-scorsa] .voci {
    margin-inline: auto;
  }

  .voci a {
    text-decoration: none;
    font-size: var(--t-body-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: currentColor;
    opacity: 0.66;
    transition: opacity var(--dur-1) var(--ease-out);
  }

  .voci a:hover,
  .voci a[aria-current='page'] {
    opacity: 1;
  }

  .scambio {
    display: block;
    overflow: hidden;
    height: 1.4em;
    line-height: 1.4em;
  }

  .scambio > span {
    display: block;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .voci a:hover .scambio > span,
  .voci a:focus-visible .scambio > span {
    transform: translateY(-100%);
  }

  .coda {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .invito {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--t-body-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    background: var(--signal);
    color: var(--signal-on);
    border-radius: 999px;
    padding: 10px 8px 10px 18px;
    white-space: nowrap;
    overflow: hidden;
  }

  /* La freccia si allunga: l'asta cresce da sinistra, la punta la segue. */
  .invito :global(.asta) {
    transform: scaleX(0.35);
  }

  .invito:hover :global(.asta) {
    transform: scaleX(1);
  }

  .invito:hover :global(.punta) {
    transform: translateX(2px);
  }

  .tema-guscio {
    display: contents;
  }

  .apri {
    display: none;
    padding: 8px;
    margin-right: -8px;
    color: inherit;
    border-radius: var(--radius-1);
  }

  /* I due tratti si allargano a turno: piccolo, ma dice che il bottone è vivo. */
  .apri :global(.tratto) {
    transition: transform var(--dur-2) var(--ease-out);
    transform-origin: 3.5px center;
  }

  .apri:hover :global(.alto) {
    transform: scaleX(0.72);
  }

  .apri:hover :global(.basso) {
    transform: scaleX(0.86);
  }

  /* ------------------------------- menu ---------------------------------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    background: var(--stage);
    color: var(--light);
    display: flex;
    align-items: center;
    clip-path: circle(0% at calc(100% - 40px) 40px);
    visibility: hidden;
    transition:
      clip-path 700ms var(--ease-expo),
      visibility 0s linear 700ms;
  }

  .menu.aperto {
    clip-path: circle(150% at calc(100% - 40px) 40px);
    visibility: visible;
    transition:
      clip-path 700ms var(--ease-expo),
      visibility 0s;
  }

  .chiudi {
    position: absolute;
    top: 18px;
    right: max(var(--gutter), 20px);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--light);
    opacity: 0;
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .menu.aperto .chiudi {
    opacity: 1;
    transition-delay: 320ms;
  }

  .chiudi:hover {
    transform: rotate(90deg);
  }

  .menu-dentro {
    display: grid;
    gap: var(--sp-8);
    width: 100%;
  }

  .menu-voci {
    display: grid;
    gap: var(--sp-2);
  }

  .riga {
    display: block;
    overflow: hidden;
  }

  .riga > * {
    display: block;
    transform: translateY(100%);
    transition: transform 600ms var(--ease-out);
  }

  /* Le righe partono al 55% dell'espansione del cerchio: prima sarebbero
     coperte dal fondo che sta ancora arrivando. */
  .menu.aperto .riga > * {
    transform: none;
    transition-delay: calc(385ms + var(--i, 0) * 60ms);
  }

  .menu:not(.aperto) .riga > * {
    transition-delay: 0s;
    transition-duration: var(--dur-2);
  }

  .menu-voci a {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(38px, 11vw, 68px);
    line-height: 1.14;
    letter-spacing: -0.04em;
    text-decoration: none;
    width: fit-content;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .menu-voci a:hover {
    transform: translateX(14px);
    color: var(--signal);
  }

  .menu-voci a[aria-current='page'] {
    color: var(--signal);
  }

  .menu-piede {
    display: grid;
    gap: var(--sp-2);
    font-size: var(--t-body-sm);
  }

  .menu-piede a {
    text-decoration: none;
    border-bottom: 1px solid var(--edge);
    padding-bottom: 2px;
  }

  .menu-piede .etichetta {
    color: var(--light-2);
    margin-top: var(--sp-2);
  }

  /* --------------------------- sotto i 1024px ----------------------------- */
  @media (max-width: 1023px) {
    .voci,
    .invito {
      display: none;
    }

    .apri {
      display: grid;
      place-items: center;
    }
  }

  :global(html[data-menu-aperto]) .intestazione {
    opacity: 0;
    pointer-events: none;
  }

  :global(html[data-menu-aperto]),
  :global(html[data-menu-aperto] body) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .marchio:hover .bollo,
    .chiudi:hover,
    .menu-voci a:hover {
      transform: none;
    }
  }
</style>

<script>
  /**
   * `astro:page-load` scatta anche al primo caricamento: montare qui e anche
   * subito significherebbe due ascoltatori sullo stesso clic. Il segno sul
   * bottone rende il montaggio ripetibile senza danni.
   */
  function montaIntestazione() {
    const intestazione = document.querySelector<HTMLElement>('[data-intestazione]');
    const sentinella = document.querySelector<HTMLElement>('[data-sentinella]');
    const bottone = document.querySelector<HTMLButtonElement>('[data-apri]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');

    if (!intestazione || !sentinella || !bottone || !menu) return;
    if (bottone.dataset.montato) return;
    bottone.dataset.montato = 'si';

    const osservatore = new IntersectionObserver(
      ([voce]) => {
        intestazione.toggleAttribute('data-scorsa', !voce.isIntersecting);
      },
      { rootMargin: '0px' }
    );
    osservatore.observe(sentinella);

    const focalizzabili = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter(
        (el) => el.offsetParent !== null
      );

    function apri() {
      menu.classList.add('aperto');
      menu.removeAttribute('inert');
      bottone.setAttribute('aria-expanded', 'true');
      document.documentElement.setAttribute('data-menu-aperto', '');
      focalizzabili()[0]?.focus();
    }

    function chiudi() {
      menu.classList.remove('aperto');
      menu.setAttribute('inert', '');
      bottone.setAttribute('aria-expanded', 'false');
      document.documentElement.removeAttribute('data-menu-aperto');
      /* Sempre al bottone: è il controllo che possiede il menu, ed è dove chi
         naviga da tastiera si aspetta di ritrovarsi. */
      bottone.focus();
    }

    bottone.addEventListener('click', () => {
      menu.classList.contains('aperto') ? chiudi() : apri();
    });

    menu.querySelector<HTMLButtonElement>('[data-chiudi]')?.addEventListener('click', chiudi);

    document.addEventListener('keydown', (e) => {
      if (!menu.classList.contains('aperto')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        chiudi();
        return;
      }

      /* Trappola per il fuoco: senza, il tabulatore esce dal menu e continua a
         scorrere i link della pagina sotto, che è coperta e illeggibile. */
      if (e.key === 'Tab') {
        const elementi = focalizzabili();
        if (elementi.length === 0) return;
        const primo = elementi[0];
        const ultimo = elementi[elementi.length - 1];

        if (e.shiftKey && document.activeElement === primo) {
          e.preventDefault();
          ultimo.focus();
        } else if (!e.shiftKey && document.activeElement === ultimo) {
          e.preventDefault();
          primo.focus();
        }
      }
    });

    document.addEventListener('astro:before-swap', () => {
      if (menu.classList.contains('aperto')) {
        menu.classList.remove('aperto');
        menu.setAttribute('inert', '');
        document.documentElement.removeAttribute('data-menu-aperto');
      }
    });
  }

  montaIntestazione();
  document.addEventListener('astro:page-load', montaIntestazione);
</script>
