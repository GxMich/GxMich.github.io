---
import { SITE } from '../config.js';

/**
 * Se non ci sono testimonianze vere, questa sezione non esiste.
 *
 * È una scelta, non una mancanza: un portfolio senza testimonianze sembra
 * giovane, uno con testimonianze inventate sembra disonesto, e la seconda
 * cosa costa molto più della prima. Quando arriva la prima frase vera, la
 * metti in config.js e la sezione compare da sola.
 */
const voci = SITE.testimonianze ?? [];
---

{
  voci.length > 0 && (
    <section class="band testimonianze" aria-labelledby="dicono">
      <div class="wrap">
        <h2 id="dicono" class="h2 testa" data-reveal>
          Cosa dice chi ci ha lavorato.
        </h2>

        <div class="griglia" data-reveal-group>
          {voci.map((v) => (
            <figure class="voce" data-reveal>
              <blockquote>
                <p>{v.testo}</p>
              </blockquote>
              <figcaption>
                <span class="autore">{v.autore}</span>
                <span class="ruolo label-plain">
                  {[v.ruolo, v.attivita, v.luogo].filter(Boolean).join(' · ')}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .testa {
    max-width: 18ch;
    margin-bottom: clamp(34px, 4vw, 56px);
  }
  .griglia {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(24px, 3vw, 44px);
  }
  .voce {
    margin: 0;
    display: grid;
    gap: 20px;
    align-content: start;
    border-top: 1px solid var(--border);
    padding-top: 24px;
  }
  .voce blockquote {
    margin: 0;
  }
  .voce blockquote p {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 1.9vw, 22px);
    line-height: 1.4;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  /* Le virgolette sono tipografiche e decorative: non devono finire nel
     testo letto ad alta voce, dove diventerebbero rumore. */
  .voce blockquote p::before {
    content: '\201C';
  }
  .voce blockquote p::after {
    content: '\201D';
  }
  figcaption {
    display: grid;
    gap: 5px;
  }
  .autore {
    font-size: 15px;
    font-weight: 500;
  }
  .ruolo {
    color: var(--text-muted);
  }
</style>
