---
/**
 * Guscio — il layout della direzione nuova.
 *
 * Convive con Base.astro finché le pagine non sono migrate una per una. Qui
 * dentro non c'è preloader, né cursore su misura, né navigazione flottante:
 * erano i tre effetti che l'audit ha bocciato per primi.
 */
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import Intestazione from '../components/struttura/Intestazione.astro';
import Piede from '../components/struttura/Piede.astro';
import Consenso from '../components/comuni/Consenso.astro';
import { SITE } from '../config.js';

interface Props {
  titolo: string;
  descrizione: string;
  ogImage?: string;
  noindex?: boolean;
  /** Le pagine riservate non caricano nemmeno la fascia delle misure di traffico:
   *  chi scrive lì dentro non deve finire in una registrazione di Clarity. */
  senzaMisure?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  titolo,
  descrizione,
  ogImage = '/og/home.png',
  noindex = false,
  senzaMisure = false,
  jsonLd,
} = Astro.props;

const percorso = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonico = new URL(percorso, Astro.site ?? SITE.url);
const urlOg = new URL(ogImage, Astro.site ?? SITE.url);
const blocchi = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

/* Corta di proposito: sopra i 300ms una transizione smette di sembrare
   fluidità e comincia a sembrare attesa. */
const passaggio = {
  old: { name: 'pagina-esce', duration: '0.16s', easing: 'cubic-bezier(0.4,0,1,1)', fillMode: 'both' },
  new: { name: 'pagina-entra', duration: '0.28s', easing: 'cubic-bezier(0.16,1,0.3,1)', fillMode: 'both' },
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Google Tag Manager e Clarity non stanno qui.

      Erano due script in chiaro in testa al documento, quindi partivano al
      primo byte, prima che chiunque potesse dire la sua — e con loro
      partivano i cookie. Adesso li inietta la fascia del consenso, dopo un
      sì: vedi src/components/comuni/Consenso.astro. Se li rimetti qui il
      consenso torna a essere una formalità, e la pagina privacy torna a
      dire una cosa falsa.
    */}

    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={canonico.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAFA" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B0B0D" />
    <meta name="color-scheme" content="light dark" />

    {/* I due tagli che si vedono per primi. Il serif arriva dopo: compare solo
        a metà pagina e non vale un blocco sul primo disegno. */}
    <link rel="preload" href="/fonts/geist-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-var.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={`${SITE.name} — ${SITE.tagline}`} />
    <meta property="og:title" content={titolo} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={canonico.href} />
    <meta property="og:image" content={urlOg.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titolo} />
    <meta name="twitter:description" content={descrizione} />
    <meta name="twitter:image" content={urlOg.href} />

    {blocchi.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}

    <script is:inline>
      // Prima del primo disegno, e in questo ordine.
      //
      // Il tema per primo: se la scelta salvata arrivasse dopo il primo
      // disegno, chi ha scelto lo scuro vedrebbe un lampo bianco a ogni
      // pagina. Senza scelta salvata non si scrive niente e comanda il sistema.
      function vestiRadice() {
        try {
          var salvato = localStorage.getItem('tema');
          if (salvato === 'chiaro' || salvato === 'scuro') {
            document.documentElement.dataset.tema = salvato;
          }
        } catch (e) {
          /* navigazione privata: resta la preferenza di sistema */
        }

        // Il contenuto si nasconde solo se c'è qualcuno che può rivelarlo.
        // Senza questa riga, un errore di JavaScript lascia la pagina bianca.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('puo-animare');
        }
      }

      vestiRadice();

      /**
       * E daccapo a ogni navigazione, perché il ClientRouter cancella quello
       * che abbiamo appena scritto.
       *
       * Scambiando le pagine, Astro riporta gli attributi di <html> a quelli
       * del documento in arrivo: quel documento è HTML statico e non ha né
       * `data-tema` né la classe `puo-animare`, che nascono qui a runtime.
       * Risultato: chi aveva scelto il chiaro con il sistema in scuro vedeva
       * la pagina successiva tornare scura, e le comparse smettevano di
       * montarsi dalla seconda pagina in poi.
       *
       * `astro:after-swap` scatta a DOM già scambiato ma prima del disegno,
       * quindi si riscrive tutto senza che si veda un lampo. Il listener sta
       * su `document`, che non viene sostituito, e infatti sopravvive alle
       * navigazioni: questo script gira una volta sola per visita.
       *
       * Va tenuto qui dentro e non in Tema.astro: `astro:page-load` arriva
       * troppo tardi — dopo il disegno — e il lampo si vedrebbe.
       */
      document.addEventListener('astro:after-swap', vestiRadice);
    </script>

    <ClientRouter fallback="none" />
  </head>

  <body>
    {/* Via anche il riquadro nascosto per chi ha JavaScript spento: quello
        chiamava Google al caricamento e non c'è modo di condizionarlo a una
        scelta, perché la scelta si esprime con JavaScript. Senza JavaScript
        non ci sono misure e va bene così. */}

    <a class="salta" href="#contenuto">Salta al contenuto</a>

    <Intestazione transition:persist />

    <main id="contenuto" transition:animate={{ forwards: passaggio, backwards: passaggio }}>
      <slot />
    </main>

    <Piede transition:animate="none" />

    {!senzaMisure && <Consenso />}

    <script>
      // Le comparse valgono per ogni pagina: montarle qui evita che ogni
      // sezione si porti dietro il proprio osservatore.
      import { montaComparse } from '../lib/movimento.ts';

      montaComparse();
      document.addEventListener('astro:page-load', () => montaComparse());
    </script>
  </body>
</html>
