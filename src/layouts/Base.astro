---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/react/Preloader.tsx';
import CursoreCustom from '../components/CursoreCustom.astro';
import ScorrimentoFluido from '../components/ScorrimentoFluido.astro';
import NavFlottante from '../components/react/NavFlottante.tsx';
import { SITE, NAV } from '../config.js';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage = '/og/home.png', noindex = false, jsonLd } = Astro.props;

/**
 * Transizione fra pagine: la vecchia esce in fretta e in linea retta, la nuova
 * entra un filo più lenta con la stessa curva del resto del sito.
 *
 * I tempi sono corti di proposito. Sopra i 300 ms una transizione smette di
 * sembrare fluidità e comincia a sembrare attesa — e su un sito che si vanta
 * di caricare veloce sarebbe un autogol. La nuova pagina sale di 8 pixel:
 * abbastanza per dare una direzione, troppo poco per far aspettare.
 *
 * Avanti e indietro sono identici: qui non c'è una gerarchia di pagine da
 * raccontare col verso dello scorrimento.
 */
const passaggio = {
  old: {
    name: 'pagina-esce',
    duration: '0.16s',
    easing: 'cubic-bezier(0.4, 0, 1, 1)',
    fillMode: 'both',
  },
  new: {
    name: 'pagina-entra',
    duration: '0.28s',
    easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
    fillMode: 'both',
  },
};
const transizionePagina = { forwards: passaggio, backwards: passaggio };

const percorso = Astro.url.pathname.replace(/\/$/, '') || '/';
const inHome = percorso === '/';
const canonical = new URL(percorso, Astro.site ?? SITE.url);
const ogUrl = new URL(ogImage, Astro.site ?? SITE.url);
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<!-- class="dark" è quello che tiene attive le varianti dark: dei componenti
     Aceternity: il sito ha un tema solo e non dipende dalle preferenze di sistema -->
<html lang="it" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0A0A0C" />
    <meta name="color-scheme" content="dark" />

    <!-- i due tagli che si vedono per primi -->
    <link rel="preload" href="/fonts/general-sans-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={`${SITE.name} — ${SITE.tagline}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl.href} />

    {blocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <script is:inline>
      // Prima del paint: niente contenuti nascosti se il JS non arriva mai.
      (function () {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('can-animate');
        }
      })();
    </script>

    {/*
      Navigazione senza ricaricare la pagina. Si appoggia alle View Transitions
      native del browser: dove non ci sono — Firefox, per ora — la navigazione
      resta quella normale e non si rompe niente.

      `fallback="none"` è voluto: la simulazione JavaScript della transizione
      costa più di quanto valga, e su un sito di sei pagine il salto secco è
      preferibile a un'animazione finta che scatta.
    */}
    <ClientRouter fallback="none" />
  </head>

  <body>
    <a class="skip" href="#contenuto">Salta al contenuto</a>

    {/*
      Il preloader si monta solo in home. Prima stava su tutte le pagine con
      `mostra={inHome}`, cioè su cinque pagine su sei caricava React per poi
      decidere di non disegnare niente: 57 KB per un ramo `if` andato a vuoto.
      Adesso /servizi, /contatti, /privacy e la 404 non caricano React affatto.

      transition:persist perché non deve ripartire a ogni clic: chi torna in
      home dopo aver girato il sito ha già visto il conteggio.
    */}
    {inHome && <Preloader client:load transition:persist />}
    <CursoreCustom />
    <ScorrimentoFluido />

    {/* Header e footer non si animano: sono i due punti fermi mentre il
        contenuto in mezzo cambia. Farli sfumare a ogni clic dà l'idea che
        tutta la pagina sia stata ricaricata, cioè l'opposto del punto. */}
    <Header transition:animate="none" />
    {/* client:idle e non client:load: non serve al primo disegno, entra in
        scena solo dopo che si è scorso oltre l'apertura. */}
    <NavFlottante client:idle voci={NAV} percorso={percorso} transition:persist />
    <main id="contenuto" transition:animate={transizionePagina}><slot /></main>
    <Footer transition:animate="none" />

    <script>
      import '../scripts/ui.ts';
    </script>

    <style is:global>
      /* il preloader blocca lo scorrimento finché non si toglie di mezzo */
      html[data-preloader='attivo'],
      html[data-preloader='attivo'] body {
        overflow: hidden;
      }
    </style>
  </body>
</html>
