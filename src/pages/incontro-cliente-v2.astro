    .voce > :first-child {
      grid-column: 1 / -1;
    }

    .voce > :last-child {
      grid-column: 1 / -1;
    }

    .barra-comandi {
      width: 100%;
    }

    .elenco {
      flex: 1 1 100%;
    }
  }
</style>

