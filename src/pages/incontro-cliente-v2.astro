      padding-inline: 6px;
      font-size: 13px;
    }

    .extra {
      grid-template-areas:
        'nome nome'
        'q p'
        'tot tot';
      grid-template-columns: 96px minmax(0, 1fr);
      row-gap: var(--sp-2);
    }

    .extra-nome {
      grid-area: nome;
    }

    .extra-q {
      grid-area: q;
    }

    .extra-p {
      grid-area: p;
    }

    .extra-t {
      grid-area: tot;
