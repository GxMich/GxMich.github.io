---
/**
 * Chi sono.
 *
 * È la pagina che si legge dopo aver già deciso di essere interessati: può
 * permettersi di essere lunga.
 *
 * La linea temporale nasce per un problema di credibilità, non di grafica.
 * Scrivere "sviluppo software da anni" con tre anni alle spalle suona vago, e
 * il vago in un portfolio si legge come reticenza. Tre anni mostrati — con
 * dentro cosa è successo in ognuno — sono più solidi di dieci dichiarati.
 */
import { Image } from 'astro:assets';
import Guscio from '../layouts/Guscio.astro';
import Invito from '../components/sezioni/Invito.astro';
import SequenzaTesti from '../components/comuni/SequenzaTesti.astro';
import ritratto from '../assets/michele.png';
import scrivania from '../assets/me/scrivania.jpg';
import { SITE } from '../config.js';
import { ID, persona, briciole } from '../lib/schema.ts';

const tappe = [
  {
    anno: '2023',
    titolo: 'Imparo a programmare, da solo',
    testo:
      'Il primo progetto finito si chiamava LightenUp: un tracciatore di allenamenti in PHP, uguale a centinaia di altri. Non lo apriva nessuno, me compreso. Mi ha insegnato la cosa che conta: finire non basta, bisogna risolvere qualcosa a qualcuno.',
  },
  {
    anno: '2024 – 2025',
    titolo: 'Il magazzino diventa la palestra',
    testo:
      'Da problem solver vedo ogni giorno dove il processo si inceppa. Comincio a costruire strumenti per il mio stesso lavoro: il tracciamento dei pallet, il monitoraggio dei tempi di consegna. Non sono esercizi — se sbaglio un dato, si ferma un camion.',
  },
  {
    anno: '2026',
    titolo: 'Progetti miei, portati fino in fondo',
    testo:
      'SuiteFit, la piattaforma per personal trainer e nutrizionisti. Il banco olografico, che smonta motori CAD a gesti davanti alla webcam. E i primi siti per attività del territorio.',
  },
  {
    anno: 'Oggi',
    titolo: 'Lo stesso mestiere, altri strumenti',
    testo:
      "Continuo a fare il problem solver: cambia solo che alcuni problemi li risolvo con una procedura e altri con del codice. Quando torno su LightenUp lo riscrivo da zero — smette di essere un'app per allenamenti e diventa un diario emotivo, che è la cosa che mancava davvero.",
  },
];

const faLaMacchina = [
  { titolo: 'Esplorare varianti', testo: 'Tre impostazioni di homepage invece di una, per capire quale regge meglio i tuoi contenuti veri. È la cosa in cui mi fa guadagnare più tempo.' },
  { titolo: 'Scrivere il codice ripetitivo', testo: 'Griglie, form, stati di errore, adattamento al telefono. Roba che so scrivere a memoria e che non mi diverte più da anni.' },
  { titolo: 'Controllare il lavoro', testo: 'Rileggere il codice cercando errori, contrasti insufficienti, link rotti, cose che ho dimenticato. Un secondo paio di occhi che non si stanca.' },
  { titolo: 'Fare la prima stesura dei testi', testo: 'Una base da correggere, mai da pubblicare così. I testi di un sito vanno riscritti da chi ha parlato col cliente.' },
];

const restaUmano = [
  { titolo: 'Capire cosa vuoi davvero comunicare', testo: "Nessun modello linguistico è stato nel tuo locale il venerdì sera. Questa parte si fa parlando, guardando, e a volte contraddicendo quello che mi hai detto all'inizio." },
  { titolo: 'Il gusto', testo: "L'IA, se le lasci scegliere, converge sempre sulla media di quello che ha visto. La media è il motivo per cui tanti siti si somigliano. Scegliere cosa togliere è un lavoro di gusto, e il gusto non si delega." },
  { titolo: 'Le decisioni di prodotto', testo: 'Cosa mettere in home e cosa no, quali funzioni valgono il loro costo, quando dirti che una cosa che hai chiesto ti farà perdere clienti.' },
  { titolo: 'Il rapporto con te', testo: 'Rispondere al telefono, spiegarti le scelte senza gergo, esserci quando qualcosa non va. Il pezzo più importante e quello meno automatizzabile.' },
];

/**
 * Le due colonne diventano una sequenza sola: l'etichetta dice da che parte
 * sta ogni voce, quindi la distinzione resta senza bisogno di due colonne che
 * su telefono si impilano comunque una sotto l'altra.
 */
const metodoIA = [
  ...faLaMacchina.map((v) => ({ ...v, nota: 'Lo fa la macchina' })),
  ...restaUmano.map((v) => ({ ...v, nota: 'Non lo delego mai' })),
];

const tappeLavoro = [
  { etichetta: 'Da solo', testo: 'Pochi progetti alla volta. Parli sempre con me, e chi scrive il codice è la stessa persona che ti ha ascoltato.' },
  { etichetta: 'Fuori orario', testo: 'Ho un lavoro a turni, quindi rispondo la sera e nei fine settimana. Non è un limite nascosto: te lo dico prima, così sai cosa aspettarti sui tempi.' },
  { etichetta: 'Se non sono adatto', testo: 'Te lo dico alla prima chiamata, non al terzo incontro. E quando posso ti indico chi contattare al posto mio.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Chi sono e come lavoro',
    url: `${SITE.url}/chi-sono`,
    about: { '@id': ID.persona },
    mainEntity: { '@id': ID.persona },
  },
  persona,
  briciole([
    { nome: 'Home', percorso: '/' },
    { nome: 'Chi sono', percorso: '/chi-sono' },
  ]),
];
---

<Guscio
  titolo="Chi sono e come lavoro con l'IA — Michele, sviluppatore web"
  descrizione="Sviluppatore web di Trino, lavoro fra Vercelli, Casale Monferrato e Novara. Come uso davvero l'IA nel mio lavoro: cosa le lascio fare, cosa non le lascio decidere e perché."
  ogImage="/og/chi-sono.png"
  jsonLd={jsonLd}
>
  <header class="testata">
    <div class="contenitore dentro">
      <div class="apertura">
        <p class="etichetta">Chi sono</p>
        <h1 class="display otturatore" data-anima>
          <span class="riga"><span>Risolvo problemi in magazzino.</span></span>
          <span class="riga"><span>Poi li risolvo di nuovo, in codice.</span></span>
        </h1>
        <div class="intro sfoca-entra" data-anima>
          <p class="testo">
            Mi chiamo {SITE.name}, sviluppo siti e software su misura. Sto a {SITE.city},
            lavoro di persona fra Vercelli, Casale Monferrato e Novara, e da remoto con
            clienti in tutta Italia.
          </p>
          <p class="testo">
            <strong>Non sono uno che chiede a un'IA di fare un sito.</strong> Sono uno che sa
            scrivere quel codice a mano e che ha deciso di usare l'IA dove ha senso, perché il
            risultato viene meglio. Sotto ti spiego esattamente dove.
          </p>
        </div>
      </div>

      <figure class="ritratto">
        <Image
          src={ritratto}
          alt={`${SITE.name}, sviluppatore web a ${SITE.city}`}
          widths={[320, 480, 640]}
          sizes="(max-width: 900px) 220px, 300px"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="etichetta">{SITE.name} — {SITE.city}</figcaption>
      </figure>
    </div>
  </header>

  <section class="sezione percorso" aria-labelledby="percorso">
    <div class="contenitore">
      <div class="intestazione">
        <h2 id="percorso" class="h2">Come ci sono arrivato.</h2>
        <p class="testo-sm">
          Tre anni di codice. Non venti, e non provo a farteli sembrare tali — compreso
          l'anno in cui ho costruito una cosa che non serviva a nessuno.
        </p>
      </div>

      <div class="percorso-corpo">
        <ol class="linea">
          {
            tappe.map((t) => (
              <li class="tappa sfoca-entra" data-anima>
                <p class="etichetta anno">{t.anno}</p>
                <p class="h3">{t.titolo}</p>
                <p class="testo-sm">{t.testo}</p>
              </li>
            ))
          }
        </ol>

        <figure class="scatto">
          <Image
            src={scrivania}
            alt="La mia scrivania: monitor, tastiera e taccuino, con la luce che entra dalla finestra"
            widths={[320, 520, 780]}
            sizes="(max-width: 900px) 100vw, 320px"
            formats={['avif', 'webp']}
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  {/*
    Otto voci su due colonne erano un muro di testo che si legge solo se uno ha
    già deciso di leggerlo — e da telefono nemmeno quello. Una alla volta, con
    l'etichetta che dice da che parte sta, fa la stessa cosa in metà fatica.
  */}
  <SequenzaTesti
    occhiello="Il pezzo che di solito nessuno racconta"
    titolo="Dove entra la macchina, e dove non la lascio entrare."
    voci={metodoIA}
  />

  <section class="sezione">
    <div class="contenitore">
      <p class="onesta">
        <strong>Il rovescio, per onestà:</strong> l'IA sbaglia, e sbaglia in modo convincente.
        Per questo ogni cosa che consegno l'ho letta, provata e capita riga per riga. Se una
        parte del lavoro non la so verificare, quella parte non la uso.
      </p>
    </div>
  </section>

  <section class="sezione come" aria-labelledby="come">
    <div class="contenitore">
      <div class="intestazione">
        <h2 id="come" class="h2">Come lavoro.</h2>
        <p class="testo-sm">
          Tre cose che di solito si scoprono strada facendo. Preferisco dirle prima.
        </p>
      </div>

      <ul class="tappe-lavoro">
        {
          tappeLavoro.map((t) => (
            <li class="sfoca-entra" data-anima>
              <p class="etichetta">{t.etichetta}</p>
              <p class="testo-sm">{t.testo}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Invito />
</Guscio>

<style>
  .testata {
    padding-block: clamp(40px, 6vw, 88px) clamp(32px, 4vw, 56px);
  }

  .dentro {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }

  .apertura .etichetta {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .riga {
    display: block;
    overflow: hidden;
  }

  .riga > span {
    display: block;
  }

  h1 {
    max-width: 20ch;
  }

  .intro {
    display: grid;
    gap: var(--sp-4);
    margin-top: clamp(24px, 3vw, 36px);
  }

  strong {
    font-weight: 500;
  }

  /* Il ritratto sta a destra del testo e non sopra: chi legge deve arrivare
     alla faccia mentre legge chi sei, non prima di sapere di chi si tratta. */
  .ritratto {
    margin: 0;
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
  }

  .ritratto img {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: var(--radius-2);
    filter: grayscale(1) contrast(1.04);
  }

  .sezione {
    padding-block: var(--section-sm);
  }

  .percorso {
    background: var(--paper-sunk);
  }

  .intestazione {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(16px, 3vw, 48px);
    align-items: baseline;
    padding-bottom: clamp(28px, 3.5vw, 48px);
    border-bottom: 1px solid var(--ink);
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .intestazione h2 {
    max-width: 16ch;
  }

  .intestazione p {
    max-width: 56ch;
  }

  .percorso-corpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .linea {
    display: grid;
    border-left: 1px solid var(--rule);
  }

  .tappa {
    display: grid;
    gap: var(--sp-2);
    padding: 0 0 clamp(28px, 3.5vw, 48px) clamp(20px, 3vw, 40px);
    position: relative;
  }

  .tappa::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 6px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
  }

  .tappa:last-child {
    padding-bottom: 0;
  }

  .tappa p:last-child {
    max-width: 56ch;
  }

  .anno {
    color: var(--ink);
  }

  .scatto {
    margin: 0;
    width: clamp(240px, 26vw, 320px);
    position: sticky;
    top: calc(var(--header-h) + var(--sp-6));
  }

  .scatto img {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: var(--radius-2);
    filter: grayscale(1) contrast(1.08) brightness(0.98);
  }

  .due-colonne {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 72px);
  }

  .colonna .etichetta {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--sp-5);
  }

  .voci {
    display: grid;
    gap: var(--sp-6);
  }

  .voci li {
    display: grid;
    gap: var(--sp-2);
  }

  .voci p:last-child {
    max-width: 46ch;
  }

  .onesta {
    margin-top: clamp(32px, 4vw, 56px);
    max-width: 66ch;
    color: var(--ink-2);
    border-left: 2px solid var(--signal);
    padding-left: var(--sp-5);
  }

  .onesta strong {
    color: var(--ink);
  }

  .tappe-lavoro {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
    border-top: 1px solid var(--ink);
  }

  .tappe-lavoro li {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    padding-top: var(--sp-5);
  }

  .tappe-lavoro p:last-child {
    max-width: 40ch;
  }

  @media (max-width: 900px) {
    .dentro,
    .intestazione,
    .percorso-corpo,
    .due-colonne,
    .tappe-lavoro {
      grid-template-columns: 1fr;
    }

    .ritratto {
      width: min(220px, 55%);
      order: -1;
    }

    .scatto {
      position: static;
      width: min(280px, 70%);
    }

    .tappe-lavoro {
      gap: var(--sp-6);
    }
  }
</style>
