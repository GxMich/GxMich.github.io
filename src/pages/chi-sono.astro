---
/**
 * Chi sono.
 *
 * È la pagina che si legge dopo aver già deciso di essere interessati: può
 * permettersi di essere lunga.
 *
 * La linea temporale nasce per un problema di credibilità, non di grafica.
 * Scrivere "sviluppo software da anni" con tre anni alle spalle suona vago, e
 * il vago in un portfolio si legge come reticenza. Tre anni mostrati — con
 * dentro cosa è successo in ognuno — sono più solidi di dieci dichiarati.
 */
import { Image } from 'astro:assets';
import Guscio from '../layouts/Guscio.astro';
import Invito from '../components/sezioni/Invito.astro';
import SequenzaTesti from '../components/comuni/SequenzaTesti.astro';
import ritratto from '../assets/michele.png';
import scrivania from '../assets/me/scrivania.jpg';
import { SITE } from '../config.js';
import { ID, persona, briciole } from '../lib/schema.ts';

const tappe = [
  {
    anno: '2023',
    /* La linea temporale si apre qui, quindi questa tappa dà il tono a tutte
       le altre: la lezione va prima e il progetto sbagliato dopo, come prova.
       Al contrario — com'era — la prima cosa che si leggeva era un fallimento,
       e chi scorre in fretta si ferma alla prima cosa. */
    titolo: 'Ho imparato che finire un progetto non basta',
    testo:
      "Ho cominciato da autodidatta, e il primo lavoro finito era un tracciatore di allenamenti uguale a centinaia di altri: non lo apriva nessuno, me compreso. Da lì è cambiato il modo di scegliere cosa costruire — prima cerco il problema di qualcuno, poi scrivo il codice.",
  },
  {
    anno: '2024 – 2025',
    titolo: 'Ho costruito strumenti per problemi veri',
    testo:
      'In magazzino vedo ogni giorno dove il processo si inceppa, e comincio a risolverlo in codice: il tracciamento dei pallet, il monitoraggio dei tempi di consegna. Non sono esercizi — se sbaglio un dato, si ferma un camion.',
  },
  {
    anno: '2026',
    titolo: 'Ho portato lo stesso approccio nel web',
    testo:
      'Capire il problema, progettare la soluzione, costruirla. SuiteFit per personal trainer e nutrizionisti, il banco olografico che smonta motori a gesti davanti alla webcam, e i primi siti per attività del territorio.',
  },
  {
    anno: 'Oggi',
    titolo: 'Lo stesso mestiere, altri strumenti',
    testo:
      "Continuo a fare il problem solver: cambia solo che alcuni problemi li risolvo con una procedura e altri con del codice. Quando torno su LightenUp lo riscrivo da zero — smette di essere un'app per allenamenti e diventa un diario emotivo, che è la cosa che mancava davvero.",
  },
];

/**
 * Tre voci, non otto.
 *
 * La versione lunga spiegava per due schermate dove entra la macchina e dove
 * no: interessante per chi scrive software, inutile per chi sta valutando se
 * un sito gli porterà clienti. Chi vuole la versione lunga la trova nel
 * racconto dei lavori, dove è attaccata a una decisione vera.
 */
const metodoIA = [
  {
    nota: 'Lo fa la macchina',
    titolo: 'Esplorare e scrivere in fretta',
    testo:
      'Tre impostazioni di homepage invece di una, e tutto il codice ripetitivo che so già a memoria. È la parte in cui mi fa guadagnare più tempo, e quel tempo torna a te.',
  },
  {
    nota: 'Non lo delego mai',
    titolo: 'Decidere cosa dire e cosa togliere',
    testo:
      "La macchina propone, e spesso propone la cosa media: è il motivo per cui tanti siti si somigliano. Cosa mettere in home, che tono usare e cosa togliere restano scelte mie.",
  },
  {
    nota: 'Non lo delego mai',
    titolo: 'Il rapporto con te',
    testo:
      'Nessun modello ha passato un pomeriggio a sentirti raccontare il tuo lavoro. Parlarne, spiegarti le scelte senza gergo, esserci quando qualcosa non va: la parte più importante e la meno automatizzabile.',
  },
];

const tappeLavoro = [
  { etichetta: 'Da solo', testo: 'Pochi clienti alla volta. Parli sempre con me, e chi scrive il codice è la stessa persona che ti ha ascoltato.' },
  { etichetta: 'Fuori orario', testo: 'Ho un lavoro a turni, quindi rispondo la sera e nei fine settimana. Non è un limite nascosto: te lo dico prima, così sai cosa aspettarti sui tempi.' },
  { etichetta: 'Se non sono adatto', testo: 'Te lo dico alla prima chiamata, non al terzo incontro. E quando posso ti indico chi contattare al posto mio.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Chi sono e come lavoro',
    url: `${SITE.url}/chi-sono`,
    about: { '@id': ID.persona },
    mainEntity: { '@id': ID.persona },
  },
  persona,
  briciole([
    { nome: 'Home', percorso: '/' },
    { nome: 'Chi sono', percorso: '/chi-sono' },
  ]),
];
---

<Guscio
  titolo="Chi sono — sviluppatore web a Trino e Vercelli | Michele Modica"
  descrizione="Sviluppatore web di Trino (VC), lavoro fra Vercelli, Casale Monferrato e Novara. Come ci sono arrivato, come lavoro e cosa resta una decisione mia."
  ogImage="/og/chi-sono.png"
  jsonLd={jsonLd}
>
  <header class="testata">
    <div class="contenitore dentro">
      <div class="apertura">
        <p class="etichetta">Chi sono</p>
        <h1 class="display otturatore" data-anima>
          <span class="riga"><span>Risolvo problemi in magazzino.</span></span>
          <span class="riga"><span>Poi li risolvo di nuovo, in codice.</span></span>
        </h1>
        <div class="intro sfoca-entra" data-anima>
          <p class="testo">
            Mi chiamo {SITE.name}, sviluppo siti e software su misura. Sto a {SITE.city},
            lavoro di persona fra Vercelli, Casale Monferrato e Novara, e da remoto con
            clienti in tutta Italia.
          </p>
          <p class="testo">
            <strong>Uso l'IA come strumento, non come sostituto del mio lavoro.</strong> Mi
            permette di esplorare più possibilità e di automatizzare il lavoro ripetitivo.
            Strategia, design, contenuti e decisioni restano miei.
          </p>
        </div>
      </div>

      <figure class="ritratto">
        <Image
          src={ritratto}
          alt={`${SITE.name}, sviluppatore web a ${SITE.city}`}
          widths={[320, 480, 640]}
          sizes="(max-width: 900px) 220px, 300px"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="etichetta">{SITE.name} — {SITE.city}</figcaption>
      </figure>
    </div>
  </header>

  <section class="sezione percorso" aria-labelledby="percorso">
    <div class="contenitore">
      <div class="intestazione">
        <h2 id="percorso" class="h2">Ho imparato costruendo cose vere.</h2>
        <p class="testo-sm">
          Non un percorso di studi: una fila di problemi veri, risolti uno alla volta —
          compreso l'anno in cui ho costruito una cosa che non serviva a nessuno.
        </p>
      </div>

      <div class="percorso-corpo">
        <ol class="linea">
          {
            tappe.map((t) => (
              <li class="tappa sfoca-entra" data-anima>
                <p class="etichetta anno">{t.anno}</p>
                <p class="h3">{t.titolo}</p>
                <p class="testo-sm">{t.testo}</p>
              </li>
            ))
          }
        </ol>

        <figure class="scatto">
          <Image
            src={scrivania}
            alt="La mia scrivania: monitor, tastiera e taccuino, con la luce che entra dalla finestra"
            widths={[320, 520, 780]}
            sizes="(max-width: 900px) 100vw, 320px"
            formats={['avif', 'webp']}
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <SequenzaTesti
    occhiello="Come uso gli strumenti"
    titolo="Tecnologia veloce. Decisioni umane."
    voci={metodoIA}
  />

  <section class="sezione">
    <div class="contenitore">
      <p class="onesta">
        <strong>Il rovescio, per onestà:</strong> l'IA sbaglia, e sbaglia in modo convincente.
        Per questo ogni cosa che consegno l'ho letta, provata e capita riga per riga.
      </p>
    </div>
  </section>

  <section class="sezione come" aria-labelledby="come">
    <div class="contenitore">
      <div class="intestazione">
        <h2 id="come" class="h2">Come lavoro.</h2>
        <p class="testo-sm">
          Tre cose che di solito si scoprono strada facendo. Preferisco dirle prima.
        </p>
      </div>

      <ul class="tappe-lavoro">
        {
          tappeLavoro.map((t) => (
            <li class="sfoca-entra" data-anima>
              <p class="etichetta">{t.etichetta}</p>
              <p class="testo-sm">{t.testo}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Invito />
</Guscio>

<style>
  .testata {
    padding-block: clamp(40px, 6vw, 88px) clamp(32px, 4vw, 56px);
  }

  .dentro {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }

  .apertura .etichetta {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .riga {
    display: block;
    overflow: hidden;
  }

  .riga > span {
    display: block;
  }

  h1 {
    max-width: 20ch;
  }

  .intro {
    display: grid;
    gap: var(--sp-4);
    margin-top: clamp(24px, 3vw, 36px);
  }

  strong {
    font-weight: 500;
  }

  /* Il ritratto sta a destra del testo e non sopra: chi legge deve arrivare
     alla faccia mentre legge chi sei, non prima di sapere di chi si tratta. */
  .ritratto {
    margin: 0;
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
  }

  .ritratto img {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: var(--radius-2);
    filter: grayscale(1) contrast(1.04);
  }

  .sezione {
    padding-block: var(--section-sm);
  }

  .percorso {
    background: var(--paper-sunk);
  }

  .intestazione {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(16px, 3vw, 48px);
    align-items: baseline;
    padding-bottom: clamp(28px, 3.5vw, 48px);
    border-bottom: 1px solid var(--ink);
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .intestazione h2 {
    max-width: 16ch;
  }

  .intestazione p {
    max-width: 56ch;
  }

  .percorso-corpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .linea {
    display: grid;
    border-left: 1px solid var(--rule);
  }

  .tappa {
    display: grid;
    gap: var(--sp-2);
    padding: 0 0 clamp(28px, 3.5vw, 48px) clamp(20px, 3vw, 40px);
    position: relative;
  }

  .tappa::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 6px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
  }

  .tappa:last-child {
    padding-bottom: 0;
  }

  .tappa p:last-child {
    max-width: 56ch;
  }

  .anno {
    color: var(--ink);
  }

  .scatto {
    margin: 0;
    width: clamp(240px, 26vw, 320px);
    position: sticky;
    top: calc(var(--header-h) + var(--sp-6));
  }

  .scatto img {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: var(--radius-2);
    filter: grayscale(1) contrast(1.08) brightness(0.98);
  }

  .due-colonne {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 72px);
  }

  .colonna .etichetta {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--sp-5);
  }

  .voci {
    display: grid;
    gap: var(--sp-6);
  }

  .voci li {
    display: grid;
    gap: var(--sp-2);
  }

  .voci p:last-child {
    max-width: 46ch;
  }

  .onesta {
    margin-top: clamp(32px, 4vw, 56px);
    max-width: 66ch;
    color: var(--ink-2);
    border-left: 2px solid var(--signal);
    padding-left: var(--sp-5);
  }

  .onesta strong {
    color: var(--ink);
  }

  .tappe-lavoro {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
    border-top: 1px solid var(--ink);
  }

  .tappe-lavoro li {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    padding-top: var(--sp-5);
  }

  .tappe-lavoro p:last-child {
    max-width: 40ch;
  }

  @media (max-width: 900px) {
    .dentro,
    .intestazione,
    .percorso-corpo,
    .due-colonne,
    .tappe-lavoro {
      grid-template-columns: 1fr;
    }

    .ritratto {
      width: min(220px, 55%);
      order: -1;
    }

    .scatto {
      position: static;
      width: min(280px, 70%);
    }

    .tappe-lavoro {
      gap: var(--sp-6);
    }
  }
</style>
