---
/**
 * Servizi.
 *
 * Sito su misura per primo e sviluppato, tool e automazioni come secondo
 * blocco più corto: l'ordine segue chi arriva su questa pagina, non la
 * quantità di lavoro che c'è dietro le due cose.
 *
 * Le domande stanno in pagina e nei dati strutturati con la stessa risposta,
 * parola per parola. Metterne due versioni diverse è il modo più veloce per
 * farsi togliere il riquadro da Google.
 */
import Guscio from '../layouts/Guscio.astro';
import Invito from '../components/sezioni/Invito.astro';
import SequenzaTesti from '../components/comuni/SequenzaTesti.astro';
import { SITE } from '../config.js';
import { ID, domande, briciole } from '../lib/schema.ts';

/**
 * Il beneficio nel titolo, la caratteristica nel testo.
 *
 * «Dati strutturati» dice a me cosa scrivo; «farti trovare quando qualcuno
 * cerca quello che fai» dice al cliente cosa compra. La parte tecnica non
 * sparisce — scende di una riga, dove serve a chi vuole verificare.
 */
const incluso = [
  { titolo: 'Capire cosa ti distingue', testo: "Un'ora o due insieme su cosa fai, chi entra dalla tua porta e cosa ti separa dal locale a duecento metri. Da qui esce tutto il resto." },
  { titolo: 'Un sito che sembra tuo', testo: 'Colori, caratteri e impaginazione scelti sul tuo lavoro. Ti mostro più direzioni e scegliamo insieme.' },
  { titolo: 'Far trovare subito quello che conta', testo: 'Quali pagine servono davvero, in che ordine, cosa vede per primo chi arriva. Spesso vuol dire togliere pagine, non aggiungerle.' },
  { titolo: 'Parole che suonano come parli tu', testo: 'La prima stesura dei testi la scrivo io partendo da quello che mi racconti, poi la correggiamo insieme.' },
  { titolo: 'Ogni richiesta deve arrivare a qualcuno', testo: 'Form provato uno per uno prima della consegna, pulsante WhatsApp, telefono che si chiama con un tocco.' },
  { titolo: 'Farti raggiungere di persona', testo: 'Dove sei, quando sei aperto, come si arriva. Sembra banale ed è la prima cosa che cerca chi ti trova online.' },
  { titolo: 'Farti trovare quando cercano quello che fai', testo: 'Titoli e descrizioni scritti a mano, dati strutturati, scheda Google collegata: quando qualcuno cerca la tua categoria in zona, ci sei.' },
  { titolo: 'Un sito che non fa aspettare', testo: 'La maggior parte dei tuoi visitatori arriva da smartphone, spesso con poca linea. Il sito è costruito perché apra subito lì, non solo sul mio schermo.' },
];

const nonIncluso = [
  { titolo: 'E-commerce complessi', testo: 'Se hai magazzino, taglie, spedizioni, resi e centinaia di prodotti, ti indico uno specialista e-commerce: è il lavoro giusto per la persona giusta.' },
  { titolo: 'Assistenza mensile automatica', testo: 'Il progetto si paga una volta. Se poi vuoi un accordo di manutenzione lo facciamo, ma resta una scelta tua.' },
  { titolo: 'Consegne sotto la settimana', testo: 'Un lavoro su misura ha bisogno di tempo per essere capito. Se ti serve online dopodomani, ti conviene un costruttore di siti fai-da-te.' },
  { titolo: 'Prenotazioni con incasso anticipato', testo: 'Pagamenti, caparre e gestione tavoli vogliono un sistema dedicato. Il tuo lo collego volentieri; costruirlo da zero è un altro progetto.' },
];

const per = [
  'Hai un locale, un negozio, un laboratorio o uno studio e la tua presenza online oggi è una pagina social e poco altro.',
  'Vuoi un sito che sembri tuo, non uno dei tanti fatti con lo stesso stampo.',
  "Hai delle foto decenti dell'attività, o sei disposto a farne fare di nuove.",
  'Puoi dedicarmi un paio di ore vere di conversazione: senza quelle il risultato è mediocre.',
];

const nonPer = [
  'Vuoi semplicemente essere online spendendo il meno possibile: un costruttore di siti fai-da-te ti costa meno e ti basta.',
  'Vuoi un sito uguale a quello di un concorrente.',
  'Non hai tempo per rispondere alle mie domande: un sito su misura si costruisce sulle risposte.',
  'Vuoi qualcuno che gestisca i tuoi social ogni settimana.',
];

const prezzoDipende = [
  { titolo: 'Quante pagine servono', testo: 'Una pagina sola ben fatta o cinque sezioni con contenuti diversi.' },
  { titolo: 'Chi scrive i testi', testo: 'Se me li dai già pronti si accorcia; se li scrivo io partendo da zero si allunga.' },
  { titolo: 'Le fotografie', testo: 'Averle già è un risparmio. Coordinare un servizio fotografico è tempo in più.' },
  { titolo: 'Cosa deve collegarsi', testo: 'Menù digitale, prenotazioni, newsletter, gestionale: ogni pezzo aggiunge lavoro.' },
];

const sistemi = [
  { titolo: 'Automazioni', testo: 'Quel lavoro manuale che qualcuno rifà uguale ogni lunedì: rapporti, copia-incolla fra sistemi, controlli ripetitivi. Si toglie di mezzo una volta sola.' },
  { titolo: 'Strumenti interni', testo: 'Piccoli applicativi fatti sul vostro processo, non sul processo medio di un software commerciale che poi vi tocca aggirare.' },
  { titolo: 'Dashboard e dati', testo: 'Numeri sparsi in fogli diversi riuniti in una schermata sola che si aggiorna da sé, con dentro solo le cose che guardate davvero.' },
];

const faq = [
  { d: 'Quanto costa un sito su misura?', r: "Te lo dico alla prima risposta, non al terzo incontro: mi racconti cosa ti serve e ti do una cifra, non una forbice. Dipende da quante pagine servono, da chi scrive i testi, dalle fotografie disponibili e da quanti servizi esterni vanno collegati. Restano fuori dominio e hosting, circa 50-120 euro l'anno pagati direttamente al fornitore così restano intestati a te. Non c'è nessun canone obbligatorio." },
  { d: 'Quanti clienti segui alla volta?', r: "Pochi, e li conto: voglio seguire personalmente ogni progetto dall'idea alla pubblicazione. Quando ti rispondo vuol dire che ho davvero il tempo per il tuo, e se in quel momento sono pieno te lo dico subito invece di metterti in coda senza dirtelo." },
  { d: 'Quanto tempo ci vuole?', r: 'Di solito tre o quattro settimane dalla prima conversazione alla messa online. Non faccio consegne sotto la settimana: un lavoro su misura ha bisogno di tempo per essere capito, e comprimerlo si vede nel risultato.' },
  { d: 'Devo pagare un canone mensile?', r: 'No. Il prezzo è una tantum e non ti lego a nessun abbonamento. Se in seguito vuoi un accordo di manutenzione lo facciamo, ma è una scelta tua e non una condizione per lavorare insieme.' },
  { d: 'Lavori solo in zona o anche a distanza?', r: "Sto a Trino, in provincia di Vercelli. Di persona lavoro fra Vercelli, Casale Monferrato, Novara e Chivasso, e per i siti di attività locali preferisco così: bisogna vedere il posto. Per i tool e le automazioni lavoro da remoto in tutta Italia senza problemi, perché lì l'oggetto del lavoro è un processo e non un locale." },
  { d: 'Chi scrive i testi del sito?', r: 'La prima stesura la scrivo io, partendo da quello che mi racconti durante le conversazioni iniziali. Poi la correggiamo insieme finché suona come parli tu. Se hai già i testi pronti li usiamo e il lavoro si accorcia.' },
  { d: 'Posso aggiornare il sito da solo dopo la consegna?', r: 'Sì, e ti spiego come prima di chiudere il lavoro. Costruisco le cose in modo che cambiare un orario, un prezzo o una foto non richieda me. Se invece serve una modifica strutturale, quella la faccio io.' },
  { d: "Usi l'intelligenza artificiale per fare i siti?", r: "La uso come strumento, non come sostituto del mio lavoro: mi permette di esplorare più direzioni e di scrivere il codice ripetitivo in fretta. Strategia, design, contenuti e decisioni restano miei — la macchina propone, e spesso propone la cosa media." },
  { d: 'Fai anche e-commerce?', r: "Un catalogo con pochi prodotti e pagamento appoggiato a un servizio esterno sì. Se invece hai magazzino, taglie, spedizioni e resi, ti indico uno specialista e-commerce: lì serve qualcuno che faccia solo quello." },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Sito su misura per attività locali',
    serviceType: 'Progettazione e sviluppo di siti web',
    provider: { '@id': ID.persona },
    areaServed: SITE.areas,
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      description: 'Sito su misura per attività locali, una tantum, senza canone obbligatorio.',
    },
  },
  domande(faq),
  briciole([
    { nome: 'Home', percorso: '/' },
    { nome: 'Servizi', percorso: '/servizi' },
  ]),
];
---

<Guscio
  titolo="Siti su misura a Vercelli e Casale — Servizi | Michele Modica"
  descrizione="Cosa comprende un sito su misura, cosa resta fuori e cosa fa variare il prezzo. Per attività fra Vercelli, Casale Monferrato e Novara. Nessun canone obbligatorio."
  ogImage="/og/servizi.png"
  jsonLd={jsonLd}
>
  <header class="testata">
    <div class="contenitore">
      <p class="etichetta">Servizi</p>
      <h1 class="display otturatore" data-anima>
        <span class="riga"><span>Un sito su misura,</span></span>
        <span class="riga"><span>senza sorprese.</span></span>
      </h1>
      <p class="lede sfoca-entra" data-anima>
        Ti dico cosa facciamo, cosa non facciamo e cosa resta tuo. Prima di iniziare.
      </p>
    </div>
  </header>

  {/*
    Otto voci su una griglia sono otto cose che nessuno legge. Una alla volta,
    al centro, su fondo scuro: chi scorre le legge davvero, e su telefono la
    differenza è ancora più netta.
  */}
  <SequenzaTesti
    occhiello="01 · Il servizio principale — cosa comprende"
    titolo="Sito su misura per attività locali"
    voci={incluso}
  />

  <section class="sezione escluso" aria-labelledby="escluso">
    <div class="contenitore">
      <div class="intestazione">
        <p class="etichetta">I confini, detti prima</p>
        <h2 id="escluso" class="h2">Dove posso essere utile. E dove no.</h2>
      </div>

      <ul class="voci quattro">
        {
          nonIncluso.map((v) => (
            <li class="sfoca-entra" data-anima>
              <p class="h4">{v.titolo}</p>
              <p class="testo-sm">{v.testo}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sezione" aria-labelledby="perchi">
    <div class="contenitore">
      <h2 id="perchi" class="h2 largo">Per chi è pensato.</h2>

      <div class="due-colonne">
        <div class="colonna">
          <p class="etichetta">Ti riconosci qui</p>
          <ul class="lista si">
            {per.map((t) => <li class="testo-sm">{t}</li>)}
          </ul>
        </div>
        <div class="colonna">
          <p class="etichetta">Probabilmente non sono la scelta giusta se…</p>
          <ul class="lista no">
            {nonPer.map((t) => <li class="testo-sm">{t}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sezione prezzo" aria-labelledby="prezzo">
    <div class="contenitore">
      <div class="intestazione">
        <p class="etichetta">Il prezzo</p>
        <h2 id="prezzo" class="h2">Una cifra, detta prima.</h2>
      </div>

      <p class="lede sfoca-entra" data-anima>
        La cifra la sai alla prima risposta, prima di iniziare. Una cifra, non una forbice.
        Ecco cosa la fa variare.
      </p>

      <ul class="voci quattro">
        {
          prezzoDipende.map((v) => (
            <li class="sfoca-entra" data-anima>
              <p class="h4">{v.titolo}</p>
              <p class="testo-sm">{v.testo}</p>
            </li>
          ))
        }
      </ul>

      <p class="testo-sm fuori">
        Restano fuori dal prezzo il dominio e l'hosting, circa 50–120 € l'anno, pagati da te
        direttamente al fornitore così restano intestati a te. Nessun canone obbligatorio.
      </p>
    </div>
  </section>

  <section class="sezione sistemi" aria-labelledby="tool">
    <div class="contenitore">
      <div class="intestazione">
        <p class="etichetta">02 · L'altra metà</p>
        <h2 id="tool" class="h2">Tool e automazioni su misura</h2>
      </div>

      <p class="lede sfoca-entra" data-anima>
        Per aziende e professionisti, anche da remoto in tutta Italia. Qui non esiste un
        listino: il preventivo nasce da mezza giornata passata a guardare come lavorate
        adesso.
      </p>

      <ul class="voci tre">
        {
          sistemi.map((v) => (
            <li class="sfoca-entra" data-anima>
              <p class="h4">{v.titolo}</p>
              <p class="testo-sm">{v.testo}</p>
            </li>
          ))
        }
      </ul>

      <p class="testo-sm">
        <a class="freccia" href="/progetti">Guarda i sistemi che ho costruito <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <section class="sezione domande" aria-labelledby="domande">
    <div class="contenitore">
      <h2 id="domande" class="h2 largo">Le domande che mi fanno tutti.</h2>

      <dl class="faq">
        {
          faq.map((q) => (
            <div class="qa sfoca-entra" data-anima>
              <dt class="h4">{q.d}</dt>
              <dd class="testo-sm">{q.r}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Invito />
</Guscio>

<style>
  .testata {
    padding-block: clamp(40px, 6vw, 88px) clamp(32px, 4vw, 56px);
  }

  .testata .etichetta {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .riga {
    display: block;
    overflow: hidden;
  }

  .riga > span {
    display: block;
  }

  .testata .lede {
    margin-top: clamp(18px, 2.4vw, 28px);
  }

  .sezione {
    padding-block: var(--section-sm);
  }

  .escluso,
  .prezzo {
    background: var(--paper-sunk);
  }

  .intestazione {
    display: grid;
    gap: var(--sp-3);
    padding-bottom: clamp(28px, 3.5vw, 48px);
    border-bottom: 1px solid var(--ink);
    margin-bottom: clamp(28px, 3.5vw, 48px);
  }

  .largo {
    max-width: 18ch;
    padding-bottom: clamp(28px, 3.5vw, 48px);
    border-bottom: 1px solid var(--ink);
    margin-bottom: clamp(28px, 3.5vw, 48px);
  }

  .voci {
    display: grid;
    gap: clamp(24px, 3vw, 44px) var(--col-gap);
  }

  .voci.quattro {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .voci.tre {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .voci li {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
  }

  .due-colonne {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 72px);
  }

  .colonna .etichetta {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--sp-5);
  }

  .lista {
    display: grid;
    gap: var(--sp-4);
  }

  .lista li {
    position: relative;
    padding-left: var(--sp-6);
    max-width: 48ch;
  }

  /* Due segni diversi, non due colori: chi fa fatica a distinguere le tinte
     deve poter separare le due colonne lo stesso. */
  .lista li::before {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    color: var(--ink-3);
  }

  .lista.si li::before {
    content: '+';
  }

  .lista.no li::before {
    content: '−';
  }

  .prezzo .lede,
  .sistemi .lede {
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }

  .fuori {
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
    max-width: 62ch;
  }

  .freccia {
    color: var(--signal-ink);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: clamp(24px, 3vw, 40px);
  }

  /* La freccia si sposta al passaggio, come nelle schede dei lavori: era
     l'unico link a freccia del sito che restava fermo. */
  .freccia span {
    transition: transform var(--dur-1) var(--ease-out);
  }

  .freccia:hover span {
    transform: translateX(4px);
  }

  .faq {
    display: grid;
    border-top: 1px solid var(--ink);
  }

  .qa {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--sp-3) clamp(16px, 3vw, 48px);
    padding: var(--sp-5) 0;
    border-bottom: 1px solid var(--rule);
  }

  .qa dd {
    margin: 0;
    max-width: 66ch;
  }

  @media (max-width: 1023px) {
    .voci.quattro {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .voci.quattro,
    .voci.tre,
    .due-colonne,
    .qa {
      grid-template-columns: 1fr;
    }
  }
</style>
