---
/**
 * La scheda di un progetto.
 *
 * Due template, uno scheletro. Cambia cosa occupa il posto d'onore:
 *  - `sito`    apre con la schermata a piena larghezza sul palco, perché chi
 *              guarda vuole vedere com'è venuto;
 *  - `tool`    apre senza immagine, perché lì non c'è un'interfaccia da
 *              mostrare e fingere che ci sia sarebbe peggio di non averla.
 *
 * La sequenza dei cinque blocchi è la stessa per entrambi: problema, ricerca,
 * UX/UI, codice, risultati. Il blocco "ricerca" compare solo se la scheda l'ha:
 * è quello che mostra la strada scartata, ed è l'unica prova di competenza che
 * non si può fingere.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Guscio from '../../layouts/Guscio.astro';
import Blocco from '../../components/casi/Blocco.astro';
import Risultati from '../../components/casi/Risultati.astro';
import Schermate from '../../components/casi/Schermate.astro';
import Invito from '../../components/sezioni/Invito.astro';
import { originale } from '../../lib/immagini.ts';
import { briciole, progetto as schemaProgetto } from '../../lib/schema.ts';

export async function getStaticPaths() {
  const progetti = await getCollection('progetti');
  return progetti.map((progetto) => ({
    params: { slug: progetto.id },
    props: { progetto },
  }));
}

interface Props {
  progetto: CollectionEntry<'progetti'>;
}

const { progetto } = Astro.props;
const d = progetto.data;
const { Content } = await render(progetto);

/** I blocchi arrivano dal frontmatter come testo: qui diventano paragrafi. */
const paragrafi = (testo?: string) => (testo ? testo.trim().split(/\n\s*\n/) : []);

const eSito = d.tipo === 'sito';

/**
 * Dichiarata prima che qualcuno la chieda: un portfolio che confonde una
 * commessa con un'iniziativa si smonta al primo cliente che chiede il
 * riferimento.
 */
const nature = {
  cliente: 'Progetto per un cliente',
  iniziativa: 'Progetto su iniziativa',
  interno: 'Lavoro interno, anonimizzato',
} as const;

/* L'apertura del template sito: la prima schermata, grande. */
const copertina = eSito ? originale(d.schermate[0]?.src ?? d.anteprima) : undefined;
const restanti = eSito ? d.schermate.slice(1) : d.schermate;

/**
 * I numeri contano i blocchi che questa scheda ha davvero.
 *
 * Con numeri fissi, una scheda senza "ricerca" saltava da 01 a 03: chi legge
 * un solo caso non sa che esiste un blocco 02 altrove, vede un buco e lo
 * legge come un errore. L'identità del blocco la porta l'etichetta; il numero
 * dice a che punto del racconto si è, e quel punto dipende da questa scheda.
 */
const presenti = [
  'problema',
  d.ricerca ? 'ricerca' : null,
  'uxui',
  'codice',
  d.risultato.length > 0 ? 'risultati' : null,
].filter(Boolean) as string[];

const numero = (chiave: string) => String(presenti.indexOf(chiave) + 1).padStart(2, '0');

const jsonLd = [
  schemaProgetto({
    titolo: d.titolo,
    riassunto: d.riassunto,
    tipo: d.tipo,
    anno: d.anno,
    natura: d.natura,
    stato: d.stato,
    tecnologie: d.tecnologie,
    slug: progetto.id,
    immagine: copertina?.src,
  }),
  briciole([
    { nome: 'Home', percorso: '/' },
    { nome: 'Lavori', percorso: '/progetti' },
    { nome: d.titolo, percorso: `/progetti/${progetto.id}` },
  ]),
];
---

<Guscio titolo={d.metaTitolo} descrizione={d.metaDescrizione} jsonLd={jsonLd}>
  <article class="caso">
    <header class="testata">
      <div class="contenitore">
        <p class="indietro">
          <a href="/progetti"><span aria-hidden="true">←</span> Tutti i lavori</a>
        </p>

        <p class="etichetta meta">
          <span>{nature[d.natura]}</span>
          <span>{d.anno}</span>
          {d.stato && <span>{d.stato}</span>}
        </p>

        <h1 class="display otturatore" data-anima>
          <span class="riga"><span>{d.titolo}</span></span>
        </h1>

        {/* Il corsivo serif è riservato alle frasi sue: qui è una riga sola e
            grande, che è la misura in cui quel carattere funziona davvero. */}
        <p class="citazione sunto sfoca-entra" data-anima>{d.riassunto}</p>
      </div>
    </header>

    {
      copertina && (
        <div class="copertura">
          <div class="contenitore">
            <Image
              src={copertina}
              alt={d.schermate[0]?.alt ?? d.titolo}
              widths={[720, 1200, 1800]}
              sizes="(max-width: 900px) 100vw, 92vw"
              formats={['avif', 'webp']}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      )
    }

    <Blocco n={numero('problema')} etichetta="Problema" id="problema" titolo="Da dove nasce">
      {paragrafi(d.contesto).map((t) => <p class="testo sfoca-entra" data-anima>{t}</p>)}
      {paragrafi(d.problema).map((t) => <p class="testo sfoca-entra" data-anima>{t}</p>)}
    </Blocco>

    {
      d.ricerca && (
        <Blocco n={numero('ricerca')} etichetta="Ricerca" id="ricerca" titolo="La strada che ho scartato" palco>
          {paragrafi(d.ricerca).map((t) => (
            <p class="testo sfoca-entra" data-anima>
              {t}
            </p>
          ))}
        </Blocco>
      )
    }

    <Blocco n={numero('uxui')} etichetta="UX / UI" id="uxui" titolo="La direzione scelta, e perché quella">
      {paragrafi(d.soluzione).map((t) => <p class="testo sfoca-entra" data-anima>{t}</p>)}
      {restanti.length > 0 && <Schermate schermate={restanti} laterale={eSito} />}
    </Blocco>

    <Blocco
      n={numero('codice')}
      etichetta="Codice"
      id="codice"
      titolo={d.tecnica ? 'Come è fatto dentro' : 'Con cosa è costruito'}
    >
      {paragrafi(d.tecnica).map((t) => <p class="testo sfoca-entra" data-anima>{t}</p>)}
      {
        d.tecnologie.length > 0 && (
          <ul class="tecnologie">
            {d.tecnologie.map((t) => (
              <li class="dato">{t}</li>
            ))}
          </ul>
        )
      }
    </Blocco>

    {
      d.risultato.length > 0 && (
        <Blocco n={numero('risultati')} etichetta="Risultati" id="risultati" titolo="Cosa è cambiato">
          <Risultati voci={d.risultato} />
        </Blocco>
      )
    }

    <div class="contenitore">
      <div class="voce">
        <p class="etichetta">In prima persona</p>
        <div class="prosa"><Content /></div>
      </div>
    </div>
  </article>

  <Invito />
</Guscio>

<style>
  .testata {
    padding-block: clamp(28px, 4vw, 56px) clamp(28px, 4vw, 48px);
  }

  .indietro {
    margin-bottom: clamp(28px, 4vw, 52px);
  }

  .indietro a {
    font-size: var(--t-body-sm);
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .indietro a:hover {
    color: var(--ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  h1 {
    max-width: 18ch;
  }

  .riga {
    display: block;
    overflow: hidden;
  }

  .riga > span {
    display: block;
  }

  .sunto {
    margin-top: clamp(20px, 2.6vw, 32px);
    max-width: 34ch;
    color: var(--ink-2);
  }

  .copertura {
    background: var(--stage);
    padding-block: clamp(24px, 3.4vw, 56px);
  }

  .copertura img {
    width: 100%;
    height: auto;
    border: 1px solid var(--edge);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-stage);
  }

  .tecnologie {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .tecnologie li {
    border: 1px solid var(--rule);
    border-radius: var(--radius-1);
    padding: 5px 11px;
    color: var(--ink-2);
  }

  /* Il corpo libero del markdown: è la nota personale in fondo, e ha bisogno
     di un segno che la stacchi dal racconto strutturato senza gridare. */
  .voce {
    display: grid;
    gap: var(--sp-4);
    max-width: 68ch;
    padding: clamp(28px, 3.4vw, 48px) 0 var(--section-sm);
    border-top: 1px solid var(--ink);
  }

  .prosa {
    display: grid;
    gap: var(--sp-4);
  }

  .prosa :global(p) {
    text-wrap: pretty;
  }

  .prosa :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--paper-sunk);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-1);
  }

  .prosa :global(em) {
    font-family: var(--font-voice);
    font-style: italic;
    font-size: 1.12em;
  }
</style>
