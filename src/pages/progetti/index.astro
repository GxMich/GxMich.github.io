---
/**
 * I lavori, in due famiglie.
 *
 * Siti e sistemi rispondono a due domande diverse e in una griglia unica si
 * annullavano a vicenda: chi cerca un sito per la sua attività si trovava
 * davanti un visualizzatore CAD, e chi valuta la parte tecnica si trovava
 * davanti il sito di un carnevale.
 *
 * I siti stanno sempre sopra, anche quando sono uno solo e i sistemi cinque:
 * l'ordine non segue la quantità, segue chi paga.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Guscio from '../../layouts/Guscio.astro';
import SchedaSito from '../../components/comuni/SchedaSito.astro';
import Invito from '../../components/sezioni/Invito.astro';
import { originale } from '../../lib/immagini.ts';
import { briciole, elencoProgetti } from '../../lib/schema.ts';

const progetti = await getCollection('progetti');
const perOrdine = (a: (typeof progetti)[number], b: (typeof progetti)[number]) =>
  a.data.ordine - b.data.ordine;

const siti = progetti.filter((p) => p.data.tipo === 'sito').sort(perOrdine);
const sistemi = progetti.filter((p) => p.data.tipo === 'tool').sort(perOrdine);

const nature = {
  cliente: 'Per un cliente',
  iniziativa: 'Su iniziativa',
  interno: 'Lavoro interno',
} as const;

function segno(stato?: string) {
  const s = (stato ?? '').toLowerCase();
  if (s.includes('in uso') || s.includes('completo')) return 'pieno';
  if (s.includes('beta')) return 'tratto';
  return 'vuoto';
}

function etichettaStato(stato?: string) {
  const s = (stato ?? '').toLowerCase();
  if (s.includes('in uso')) return 'In uso';
  if (s.includes('completo')) return 'Completo';
  if (s.includes('beta')) return 'Beta';
  return 'In corso';
}

const jsonLd = [
  elencoProgetti(
    [...siti, ...sistemi].map((p) => ({
      titolo: p.data.titolo,
      slug: p.id,
      riassunto: p.data.riassunto,
    }))
  ),
  briciole([
    { nome: 'Home', percorso: '/' },
    { nome: 'Lavori', percorso: '/progetti' },
  ]),
];
---

<Guscio
  titolo="Lavori — siti e strumenti su misura | Michele Modica"
  descrizione="Siti per attività del territorio e strumenti per processi che si inceppano. Ogni lavoro raccontato per intero: il problema, la strada scelta e cosa è cambiato."
  ogImage="/og/progetti.png"
  jsonLd={jsonLd}
>
  <header class="testata">
    <div class="contenitore">
      <p class="etichetta">Lavori</p>
      <h1 class="display otturatore" data-anima>
        <span class="riga"><span>I lavori,</span></span>
        <span class="riga"><span>raccontati per intero.</span></span>
      </h1>
      <p class="lede sfoca-entra" data-anima>
        Ognuno con il problema di partenza, la strada che ho scelto e perché quella, e cosa
        è cambiato davvero. Compreso quello che non ha funzionato.
      </p>

      {/*
        Perché tanti «su iniziativa».

        Ogni scheda dichiara da dove nasce il lavoro, e sulla maggior parte c'è
        scritto che l'ho scelto io. Detto senza spiegazione sembra una cosa da
        nascondere, e chi valuta si chiede se ho clienti veri. Spiegato, dice
        l'opposto: sono lavori fatti per intero, con vincoli veri, invece di
        finti mockup — e sono l'unica cosa che potevo mostrare prima di avere
        una fila di clienti da mostrare.
      */}
      <p class="testo-sm nota sfoca-entra" data-anima>
        Su parecchi c'è scritto <strong>su iniziativa</strong>: li ho scelti io, non me li ha
        commissionati nessuno. Li ho costruiti per intero lo stesso — contenuti veri,
        vincoli veri, messi online — perché un portfolio di bozze non dimostra niente. Quelli
        nati da un cliente e quelli nati da me sono etichettati uno per uno, così sai sempre
        cosa stai guardando.
      </p>
    </div>
  </header>

  {
    siti.length > 0 && (
      <section class="famiglia" aria-labelledby="siti">
        <div class="contenitore">
          <div class="intestazione">
            <h2 id="siti" class="h2">Siti</h2>
            <p class="testo-sm">
              Per attività che hanno una faccia e vogliono che il sito abbia quella.
            </p>
          </div>

          <div class="griglia-siti">
            {siti.map((p, i) => (
              <SchedaSito
                href={`/progetti/${p.id}`}
                titolo={p.data.titolo}
                cliente={nature[p.data.natura]}
                riassunto={p.data.riassunto}
                anno={p.data.anno}
                immagine={p.data.schermate[0]?.src ?? p.data.anteprima}
                primo={i === 0}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    sistemi.length > 0 && (
      <section class="famiglia sistemi" aria-labelledby="sistemi">
        <div class="contenitore">
          <div class="intestazione">
            <h2 id="sistemi" class="h2">Sistemi</h2>
            <p class="testo-sm">
              Strumenti per processi che si inceppano sempre nello stesso punto. Due sono
              lavoro interno e i dati non si possono pubblicare: quello che trovi è il
              ragionamento.
            </p>
          </div>

          {/*
            Una miniatura per riga.

            I siti qui sopra si guardano, i sistemi si leggevano soltanto: due
            trattamenti diversi che facevano sembrare la seconda metà del
            portfolio materiale di serie B. La miniatura è piccola e in fondo
            alla riga di proposito — qui il titolo resta la porta d'ingresso,
            l'immagine dice solo «c'è qualcosa da vedere». Decorativa, quindi
            alt vuoto: il nome del progetto è già scritto accanto.
          */}
          <ul class="elenco">
            {sistemi.map((p) => {
              const miniatura = originale(p.data.anteprima);

              return (
              <li class="riga-sistema sfoca-entra" data-anima>
                <a href={`/progetti/${p.id}`}>
                  {miniatura && (
                    <span class="mini">
                      <Image
                        src={miniatura}
                        alt=""
                        widths={[160, 320]}
                        sizes="120px"
                        formats={['avif', 'webp']}
                        loading="lazy"
                      />
                    </span>
                  )}
                  <span class="nome h3">{p.data.titolo}</span>
                  <span class="testo-sm sunto">{p.data.riassunto}</span>
                  <span class="etichetta natura">{nature[p.data.natura]}</span>
                  <span class:list={['stato', segno(p.data.stato)]}>
                    {etichettaStato(p.data.stato)}
                  </span>
                  <span class="vai" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <Invito />
</Guscio>

<style>
  .testata {
    padding-block: clamp(40px, 6vw, 88px) clamp(40px, 6vw, 80px);
  }

  .testata .etichetta {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  h1 {
    max-width: 16ch;
  }

  .riga {
    display: block;
    overflow: hidden;
  }

  .riga > span {
    display: block;
  }

  .testata .lede {
    margin-top: clamp(20px, 2.6vw, 32px);
  }

  .nota {
    margin-top: var(--sp-5);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
    max-width: 68ch;
    color: var(--ink-2);
  }

  .nota strong {
    color: var(--ink);
    font-weight: 500;
  }

  .famiglia {
    padding-block: var(--section-sm);
  }

  .sistemi {
    background: var(--paper-sunk);
    margin-top: var(--section-sm);
  }

  .intestazione {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(16px, 3vw, 48px);
    align-items: baseline;
    padding-bottom: clamp(28px, 4vw, 52px);
    border-bottom: 1px solid var(--ink);
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .intestazione p {
    max-width: 56ch;
  }

  .griglia-siti {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 64px);
  }

  /* Un sito solo resta della sua misura: allargarlo a mezza pagina lo
     promuoveva a lavoro di punta, che e' una scelta editoriale e non una
     conseguenza del fatto che per ora e' l'unico. */

  .elenco {
    border-top: 1px solid var(--ink);
  }

  .riga-sistema a {
    display: grid;
    grid-template-columns: 104px minmax(0, 4fr) minmax(0, 6fr) auto auto auto;
    gap: var(--sp-3) clamp(16px, 2.6vw, 36px);
    align-items: center;
    padding: var(--sp-5) 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    transition: padding-inline var(--dur-1) var(--ease-out);
  }

  .riga-sistema a:hover {
    padding-inline: var(--sp-3);
  }

  /* Stessa cornice scura delle schede dei siti: la schermata chiara ha
     bisogno di uno sfondo che la stacchi, altrimenti si scioglie nella
     pagina. Il ritaglio è fisso perché le miniature restino allineate anche
     quando gli originali hanno proporzioni diverse. */
  .mini {
    display: block;
    background: var(--stage);
    border-radius: var(--radius-2);
    padding: 5px;
    overflow: hidden;
  }

  .mini img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    border-radius: 1px;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .riga-sistema a:hover .mini img {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .riga-sistema a:hover .mini img {
      transform: none;
    }
  }

  .nome {
    letter-spacing: -0.025em;
  }

  .sunto {
    max-width: 58ch;
  }

  .natura {
    white-space: nowrap;
  }

  .stato {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    white-space: nowrap;
  }

  .stato::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .stato.pieno::before {
    background: var(--ink);
  }

  .stato.vuoto::before {
    border: 1px solid var(--ink-3);
  }

  .stato.tratto::before {
    border: 1px dashed var(--ink-3);
  }

  .vai {
    color: var(--ink-3);
    transition: transform var(--dur-1) var(--ease-out);
  }

  .riga-sistema a:hover .vai {
    transform: translateX(4px);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .intestazione {
      grid-template-columns: 1fr;
    }

    .griglia-siti {
      grid-template-columns: 1fr;
    }

    /* La miniatura passa a colonna sua, alta quanto tutta la riga: sopra il
       testo occuperebbe mezza schermata e trasformerebbe l'elenco in una
       griglia, che è esattamente la forma che questa sezione non vuole. */
    .riga-sistema a {
      grid-template-columns: 68px minmax(0, 1fr) auto;
      column-gap: var(--sp-4);
      row-gap: var(--sp-2);
      align-items: start;
    }

    .mini {
      grid-column: 1;
      grid-row: 1 / span 3;
      align-self: center;
    }

    .nome {
      grid-column: 2 / -1;
      grid-row: 1;
    }

    .sunto {
      grid-column: 2 / -1;
      grid-row: 2;
    }

    .natura {
      grid-column: 2;
      grid-row: 3;
    }

    .stato {
      grid-column: 3;
      grid-row: 3;
      justify-self: end;
    }

    .vai {
      display: none;
    }
  }
</style>
