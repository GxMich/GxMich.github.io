---
/**
 * Contatti.
 *
 * È la pagina dove qualcuno sta per scriverti: ogni millisecondo di attesa e
 * ogni effetto in più è un rischio. Nessuna sezione agganciata, nessuna
 * parallasse, niente GSAP — solo il modulo, i due recapiti diretti e cosa
 * succede dopo.
 */
import Guscio from '../layouts/Guscio.astro';
import Invito from '../components/sezioni/Invito.astro';
import SequenzaTesti from '../components/comuni/SequenzaTesti.astro';
import { SITE } from '../config.js';
import { ID, briciole } from '../lib/schema.ts';

const dopo = [
  {
    nota: 'Passo 01',
    titolo: 'Ti rispondo io',
    testo:
      'Non un modulo automatico e non un commerciale. Di solito entro un giorno, di sera o nel fine settimana: ho un lavoro a turni e preferisco dirtelo prima che scoprirlo dopo.',
  },
  {
    nota: 'Passo 02',
    titolo: 'Mezz’ora al telefono, gratis',
    testo:
      'Mi racconti cosa fai e cosa ti blocca. Se penso di non essere la persona giusta per te te lo dico lì, e non ti è costato niente.',
  },
  {
    nota: 'Passo 03',
    titolo: 'Una cifra, non una forbice',
    testo:
      'Se ha senso andare avanti ti mando il prezzo e cosa comprende, per iscritto. Prima di cominciare, non al terzo incontro.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contatti',
    url: `${SITE.url}/contatti`,
    mainEntity: { '@id': ID.persona },
  },
  briciole([
    { nome: 'Home', percorso: '/' },
    { nome: 'Contatti', percorso: '/contatti' },
  ]),
];
---

<Guscio
  titolo={`Contatti — ${SITE.name}, sviluppatore web a ${SITE.city}`}
  descrizione="Scrivimi cosa fai e cosa ti blocca oggi. Rispondo io, di solito entro un giorno. La prima mezz'ora non si paga."
  ogImage="/og/contatti.png"
  jsonLd={jsonLd}
>
  <header class="testata">
    <div class="contenitore">
      <p class="etichetta">Contatti</p>
      <h1 class="display otturatore" data-anima>
        <span class="riga"><span>Scrivimi.</span></span>
      </h1>
      <p class="lede sfoca-entra" data-anima>
        Il modo più veloce per capire se posso esserti utile è raccontarmi cosa fai e cosa ti
        blocca oggi.
      </p>

      <ul class="diretti">
        <li>
          <span class="etichetta">Email</span>
          <a class="h3" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>
          <span class="etichetta">WhatsApp</span>
          <a class="h3" href={`https://wa.me/${SITE.whatsapp}`}>{SITE.whatsappLabel}</a>
        </li>
        <li>
          <span class="etichetta">Dove sono</span>
          <span class="h3">{SITE.city} ({SITE.provincia})</span>
        </li>
        <li>
          <span class="etichetta">Quando rispondo</span>
          <span class="h3">Tutti i giorni, 8–22</span>
        </li>
      </ul>
    </div>
  </header>

  <SequenzaTesti
    occhiello="Cosa succede dopo che scrivi"
    titolo="Tre passaggi, e nessuno costa niente."
    voci={dopo}
  />

  <Invito />
</Guscio>

<style>
  .testata {
    padding-block: clamp(40px, 6vw, 88px) clamp(32px, 4vw, 56px);
  }

  .testata .etichetta {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .riga {
    display: block;
    overflow: hidden;
  }

  .riga > span {
    display: block;
  }

  .testata .lede {
    margin-top: clamp(18px, 2.4vw, 28px);
  }

  .diretti {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-5) var(--col-gap);
    margin-top: clamp(36px, 5vw, 64px);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--ink);
  }

  .diretti li {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
  }

  .diretti a {
    text-decoration: none;
    color: var(--signal-ink);
    word-break: break-word;
  }

  .diretti a:hover {
    text-decoration: underline;
  }


  @media (max-width: 900px) {
    .diretti {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

  @media (max-width: 520px) {
    .diretti {
      grid-template-columns: 1fr;
    }
  }
</style>
