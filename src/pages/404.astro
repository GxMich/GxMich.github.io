---
/**
 * Pagina non trovata.
 *
 * Chi ci finisce ha sbagliato indirizzo o ha seguito un link vecchio: quello
 * che gli serve sono due strade, non una scusa lunga.
 */
import Guscio from '../layouts/Guscio.astro';
---

<Guscio
  titolo="Pagina non trovata — Michele Modica"
  descrizione="Questo indirizzo non esiste. Dai lavori o dai contatti si riparte."
  noindex={true}
>
  <section class="niente">
    <div class="contenitore">
      <p class="etichetta">Errore 404</p>
      <h1 class="display">Questa pagina non c’è.</h1>
      <p class="lede">
        O l’indirizzo è sbagliato, o l’ho spostata io e ho dimenticato di lasciare un
        cartello. Da qui si riparte.
      </p>
      <p class="strade">
        <a class="collegamento" href="/progetti">Guarda i lavori</a>
        <a class="collegamento" href="/contatti">Scrivimi</a>
        <a class="collegamento" href="/">Torna all’inizio</a>
      </p>
    </div>
  </section>
</Guscio>

<style>
  .niente {
    padding-block: clamp(64px, 12vw, 160px) var(--section);
  }

  .etichetta {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(20px, 3vw, 36px);
  }

  h1 {
    max-width: 14ch;
  }

  .lede {
    margin-top: var(--sp-5);
  }

  .strade {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
    margin-top: clamp(28px, 4vw, 48px);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
  }

  .collegamento {
    color: var(--signal-ink);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }

  .collegamento:hover {
    border-bottom-color: var(--signal-ink);
  }
</style>
