---
/**
 * Home — direzione nuova.
 *
 * Frame 01 → 05 in questo passo: apertura, vetrina, due strade, metodo, prezzo.
 * I frame 06 → 10 (chi te lo fa, prova tecnica, domande, invito) arrivano nel
 * passo successivo. La versione precedente resta nella storia di git e in
 * archive/pre-redesign-v2-2026-08-03/.
 */
import { getCollection } from 'astro:content';
import Guscio from '../layouts/Guscio.astro';
import Apertura from '../components/sezioni/Apertura.astro';
import Vetrina from '../components/sezioni/Vetrina.astro';
import DueStrade from '../components/sezioni/DueStrade.astro';
import Metodo from '../components/sezioni/Metodo.astro';
import Prezzo from '../components/sezioni/Prezzo.astro';
import Chi from '../components/sezioni/Chi.astro';
import Sistemi from '../components/sezioni/Sistemi.astro';
import Domande from '../components/sezioni/Domande.astro';
import Invito from '../components/sezioni/Invito.astro';
import { persona, attivita, sitoWeb } from '../lib/schema.ts';

const progetti = await getCollection('progetti');

const siti = progetti
  .filter((p) => p.data.tipo === 'sito')
  .sort((a, b) => a.data.ordine - b.data.ordine);

const sistemi = progetti
  .filter((p) => p.data.tipo === 'tool')
  .sort((a, b) => a.data.ordine - b.data.ordine);

/**
 * La vetrina in home mostra i lavori, tutti, siti per primi.
 *
 * La divisione stretta in due famiglie resta su /progetti, dove serve a chi sta
 * cercando qualcosa di preciso. Qui il compito è diverso: far vedere che c'è
 * roba da guardare, e dare una porta d'ingresso a ciascuna.
 */
const nature = {
  cliente: 'Per un cliente',
  iniziativa: 'Su iniziativa',
  interno: 'Lavoro interno',
} as const;

/* Ordinati per `ordine`, non per famiglia: qual e' il lavoro che apre la fila
   e' una decisione editoriale, e sta nel frontmatter dove Michele la controlla.
   La divisione stretta in siti e sistemi resta su /progetti. */
const lavori = [...progetti]
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .map((p) => ({
    href: `/progetti/${p.id}`,
    titolo: p.data.titolo,
    nota: `${nature[p.data.natura]} · ${p.data.anno}`,
    immagine: p.data.anteprima,
    alt: p.data.riassunto,
  }));

const jsonLd = [persona, attivita, sitoWeb];
---

<Guscio
  titolo="Sviluppatore web a Vercelli e Casale — Michele Modica"
  descrizione="Siti su misura per attività fra Vercelli, Casale Monferrato e Novara. Prezzo detto prima, dominio intestato a te, pochi progetti l'anno."
  ogImage="/og/home.png"
  jsonLd={jsonLd}
>
  <Apertura />

  {
    lavori.length > 0 && (
      <Vetrina
        lavori={lavori}
        occhiello="I lavori"
        titolo="Sette progetti, e cosa risolve ognuno."
      />
    )
  }

  <DueStrade />

  <Metodo />

  <Prezzo />

  <Chi />

  {sistemi.length > 0 && <Sistemi sistemi={sistemi} />}

  <Domande />

  <Invito />
</Guscio>
