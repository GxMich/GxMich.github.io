---
/**
 * Home — direzione nuova.
 *
 * Nove frame: apertura, vetrina, due strade, metodo, differenza, prezzo, chi te lo
 * fa, domande, invito. I progetti personali (Sistemi) sono usciti dalla home il
 * 19/11/2026: il sito parla solo di siti web e restano su /progetti. La versione precedente resta nella storia
 * di git e in archive/pre-redesign-v2-2026-08-03/.
 *
 * L'ordine non è casuale ed è la cosa da non toccare a cuor leggero: cosa
 * faccio (due strade) → come lo faccio (metodo) → rispetto a cos'altro
 * (scelta) → quanto costa (prezzo) → chi sono (chi). Il confronto arriva
 * prima del prezzo perché è lì che serve: dà il metro per leggerlo.
 */
import { getCollection } from 'astro:content';
import Guscio from '../layouts/Guscio.astro';
import Apertura from '../components/sezioni/Apertura.astro';
import Vetrina from '../components/sezioni/Vetrina.astro';
import DueStrade from '../components/sezioni/DueStrade.astro';
import Metodo from '../components/sezioni/Metodo.astro';
import Differenza from '../components/sezioni/Differenza.astro';
import Prezzo from '../components/sezioni/Prezzo.astro';
import Chi from '../components/sezioni/Chi.astro';
import Domande from '../components/sezioni/Domande.astro';
import Invito from '../components/sezioni/Invito.astro';
import { persona, attivita, sitoWeb } from '../lib/schema.ts';

const progetti = await getCollection('progetti');

const siti = progetti
  .filter((p) => p.data.tipo === 'sito')
  .sort((a, b) => a.data.ordine - b.data.ordine);

/**
 * La vetrina in home mostra i lavori, tutti, siti per primi.
 *
 * La divisione stretta in due famiglie resta su /progetti, dove serve a chi sta
 * cercando qualcosa di preciso. Qui il compito è diverso: far vedere che c'è
 * roba da guardare, e dare una porta d'ingresso a ciascuna.
 */
const nature = {
  cliente: 'Per un cliente',
  iniziativa: 'Su iniziativa',
  interno: 'Lavoro interno',
} as const;

/* Ordinati per `ordine`, non per famiglia: qual e' il lavoro che apre la fila
   e' una decisione editoriale, e sta nel frontmatter dove Michele la controlla.
   La divisione stretta in siti e sistemi resta su /progetti.

   In vetrina il titolo della scheda e' il problema, non il nome del progetto:
   chi guarda i lavori sta cercando qualcuno che risolva il suo, e «Pizzeria
   Moderna · 2026» non gli dice niente. Il nome resta sotto, come nota. */
/* Solo siti, clienti veri per primi, al massimo quattro (19/11/2026): la
   home era di 1.600 parole e la vetrina ne pesava quasi 300. Gli strumenti e
   i progetti personali restano su /progetti, dove li cerca chi è curioso. */
const lavori = progetti
  .filter((p) => !p.data.demo && p.data.tipo === 'sito')
  .sort(
    (a, b) =>
      Number(b.data.natura === 'cliente') - Number(a.data.natura === 'cliente') ||
      a.data.ordine - b.data.ordine,
  )
  .slice(0, 4)
  .map((p) => ({
    href: `/progetti/${p.id}`,
    titolo: p.data.sfida ?? p.data.titolo,
    nota: `${p.data.titolo} · ${nature[p.data.natura]} · ${p.data.anno}`,
    immagine: p.data.anteprima,
    alt: p.data.riassunto,
  }));

const jsonLd = [persona, attivita, sitoWeb];
---

<Guscio
  titolo="Michele Modica — siti web su misura per attività locali"
  descrizione="Siti su misura per cantine, agriturismi e attività locali del Monferrato e dintorni. Prezzo alla prima risposta, dominio intestato a te, nessun canone."
  ogImage="/og/home.png"
  jsonLd={jsonLd}
>
  <Apertura />

  {
    lavori.length > 0 && (
      <Vetrina
        lavori={lavori}
        occhiello="I lavori"
        titolo="Ogni lavoro nasce da un problema."
      />
    )
  }

  <DueStrade />

  <Metodo />

  <Differenza />

  <Prezzo />

  <Chi />

  <Domande />

  <Invito />
</Guscio>
