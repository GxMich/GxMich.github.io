---
/**
 * Home — direzione nuova.
 *
 * Frame 01 → 05 in questo passo: apertura, vetrina, due strade, metodo, prezzo.
 * I frame 06 → 10 (chi te lo fa, prova tecnica, domande, invito) arrivano nel
 * passo successivo. La versione precedente resta nella storia di git e in
 * archive/pre-redesign-v2-2026-08-03/.
 */
import { getCollection } from 'astro:content';
import Guscio from '../layouts/Guscio.astro';
import Apertura from '../components/sezioni/Apertura.astro';
import Vetrina from '../components/sezioni/Vetrina.astro';
import DueStrade from '../components/sezioni/DueStrade.astro';
import Metodo from '../components/sezioni/Metodo.astro';
import Prezzo from '../components/sezioni/Prezzo.astro';
import { persona, attivita, sitoWeb } from '../lib/schema.ts';

const progetti = await getCollection('progetti');

const siti = progetti
  .filter((p) => p.data.tipo === 'sito')
  .sort((a, b) => a.data.ordine - b.data.ordine);

const primo = siti[0];
const pagine = primo?.data.schermate ?? [];

/**
 * Con due o più siti in elenco la vetrina mostra un pannello per sito. Con uno
 * solo mostra le sue pagine, dichiarate come tali: è la degradazione onesta —
 * non finge un portfolio più ricco di quello che è, e intanto fa vedere più di
 * una schermata.
 *
 * Il giorno in cui i siti diventano tre, questo blocco cambia da solo.
 */
const pannelli =
  siti.length >= 2
    ? siti.map((p) => ({
        immagine: p.data.anteprima!,
        titolo: p.data.titolo,
        nota: p.data.cliente,
        alt: p.data.riassunto,
      }))
    : pagine.map((s) => ({
        immagine: s.src,
        titolo: primo!.data.titolo,
        nota: primo!.data.cliente,
        alt: s.alt,
      }));

const occhielloVetrina =
  siti.length >= 2 ? 'Siti messi online' : 'Il lavoro, pagina per pagina';

const titoloVetrina =
  siti.length >= 2
    ? 'Qualche sito che ho messo online.'
    : 'Un sito che si aggiorna aprendo un file di testo.';

/* L'apertura mostra l'ultima pagina disponibile: fra le due del Carnevale è
   quella che si legge meglio in piccolo. Diventa una scelta automatica quando
   i siti in elenco saranno più di uno. */
const scattoApertura = pagine[pagine.length - 1];

const jsonLd = [persona, attivita, sitoWeb];
---

<Guscio
  titolo="Sviluppatore web a Vercelli, Casale Monferrato e Novara — Michele Modica"
  descrizione="Siti su misura per attività del territorio. Da Trino, fra Vercelli, Casale Monferrato e Novara. Prezzo detto prima, dominio intestato a te, nessun canone obbligatorio."
  ogImage="/og/home.png"
  jsonLd={jsonLd}
>
  <Apertura
    immagine={scattoApertura?.src}
    alt={scattoApertura?.alt}
    didascalia={primo ? `${primo.data.titolo} — una pagina, così com'è online` : undefined}
  />

  {pannelli.length > 0 && (
    <Vetrina pannelli={pannelli} occhiello={occhielloVetrina} titolo={titoloVetrina} />
  )}

  <DueStrade />

  <Metodo />

  <Prezzo />
</Guscio>
